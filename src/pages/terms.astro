---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import { site } from "../data/site";

const title = "Terms";
const description = `Terms of use for ${site.name}.`;
---

<BaseLayout title={title} description={description}>
  <section class="border-b border-border bg-surface-muted">
    <div class="container-site py-10 sm:py-12">
      <Breadcrumb
        items={[
          { label: "Home", href: "/" },
          { label: "Terms" },
        ]}
      />
      <h1 class="mt-7 text-3xl font-bold tracking-tight text-ink sm:text-4xl">
        Terms of use
      </h1>
      <p class="mt-3 max-w-2xl text-base leading-relaxed text-ink-muted">
        Simple terms for using this directory and its editorial content.
      </p>
    </div>
  </section>
  <section class="bg-surface">
    <div class="container-site section-y">
      <div
        class="mx-auto max-w-2xl space-y-4 text-base leading-relaxed text-ink-muted"
      >
        <p>
          Content on this site — including scores, feature flags, and guides —
          is provided for general information. It is editorial opinion, not
          professional, legal, or investment advice, and not a guarantee of
          vendor performance.
        </p>
        <p>
          Product names and trademarks belong to their owners. Listings may
          include public pricing and feature notes that change; always verify on
          the vendor’s site before purchasing.
        </p>
        <p>
          You may link to our pages. Do not scrape or republish substantial
          portions of the catalog without permission. For corrections or
          partnership requests, use{" "}
          <a
            href="/contact/"
            class="font-medium text-accent hover:text-accent-hover"
            >Contact</a
          >.
        </p>
        <p>
          See also our{" "}
          <a
            href="/methodology/"
            class="font-medium text-accent hover:text-accent-hover"
            >Methodology</a
          >{" "}
          and{" "}
          <a
            href="/privacy/"
            class="font-medium text-accent hover:text-accent-hover"
            >Privacy</a
          >{" "}
          pages.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
