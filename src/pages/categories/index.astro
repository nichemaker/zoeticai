---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { getCategoryCounts, categoryHref } from "../../data/categories";

const categoryCards = getCategoryCounts();
---

<BaseLayout
  title="Categories"
  description="Browse AI agent platforms by category — enterprise, frameworks, no-code, coding, browser, and workflow."
>
  <section class="border-b border-border bg-surface-muted">
    <div class="container-site py-8 sm:py-10">
      <Breadcrumb
        items={[
          { label: "Home", href: "/" },
          { label: "Categories" },
        ]}
      />
      <h1 class="mt-6 text-3xl font-bold tracking-tight text-ink sm:text-4xl">
        Categories
      </h1>
      <p class="mt-3 max-w-2xl text-base leading-relaxed text-ink-muted sm:text-lg">
        Explore the directory by how teams buy and build agent systems.
      </p>
    </div>
  </section>

  <section class="bg-surface">
    <div class="container-site py-8 sm:py-10">
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          categoryCards.map(({ meta, count }) => (
            <a
              href={categoryHref(meta)}
              class="card-surface group flex flex-col p-6 transition-shadow duration-150 hover:shadow-(--shadow-md)"
            >
              <div class="flex items-center justify-between gap-3">
                <span
                  class="flex h-10 w-10 items-center justify-center rounded-lg bg-accent-soft text-sm font-bold text-accent"
                  aria-hidden="true"
                >
                  {meta.icon}
                </span>
                <span class="text-xs font-medium tabular-nums text-ink-soft">
                  {count} {count === 1 ? "platform" : "platforms"}
                </span>
              </div>
              <h2 class="mt-4 text-lg font-semibold text-ink group-hover:text-accent">
                {meta.name}
              </h2>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-muted">
                {meta.description}
              </p>
              <span class="mt-4 text-sm font-semibold text-accent" aria-hidden="true">
                Explore →
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
