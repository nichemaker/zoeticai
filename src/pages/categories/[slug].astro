---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ToolCard from "../../components/ToolCard.astro";
import {
  categories,
  getCategoryBySlug,
  categoryHref,
} from "../../data/categories";
import { getToolsByCategory } from "../../data/tools";
import {
  getRelatedGuidesForCategory,
  getFeaturedGuideForCategory,
  getGuideBySlug,
  guideHref,
  guideLinkLabel,
  methodologyLink,
} from "../../data/guides";
import RelatedLinks from "../../components/RelatedLinks.astro";
import { site } from "../../data/site";
import type { Tool } from "../../types/tool";

/** Categories where the platforms pillar is the natural “start here”. */
const PILLAR_CATEGORY_IDS = new Set([
  "Enterprise",
  "Frameworks",
  "No-Code",
  "Workflow",
]);
const PLATFORMS_PILLAR_SLUG = "ai-agent-platforms-guide";

/** Static paths for the six supported category slugs. */
export function getStaticPaths() {
  return categories.map((category) => ({
    params: { slug: category.slug },
    props: { category },
  }));
}

interface Props {
  category: NonNullable<ReturnType<typeof getCategoryBySlug>>;
}

const { category } = Astro.props;
const { slug } = Astro.params;

// Safety: only known slugs are generated; double-check for typos
const resolved = getCategoryBySlug(slug ?? "") ?? category;

const toolsInCategory: Tool[] = getToolsByCategory(resolved.id).sort(
  (a, b) => b.scores.overall - a.scores.overall,
);

const otherCategories = categories.filter((c) => c.slug !== resolved.slug);

const relatedGuides = getRelatedGuidesForCategory(resolved.id);
const featuredGuide = getFeaturedGuideForCategory(resolved.id);
const showPlatformsPillar = PILLAR_CATEGORY_IDS.has(resolved.id);
const platformsPillar = getGuideBySlug(PLATFORMS_PILLAR_SLUG);
const relatedLinks = [
  {
    href: "/platforms/",
    title: "All AI agent platforms",
    excerpt: "Filter the full catalog by category, features, pricing, and score.",
  },
  ...(showPlatformsPillar && platformsPillar
    ? [
        {
          href: guideHref(platformsPillar.slug),
          title: platformsPillar.title,
          excerpt:
            "Central hub: how to choose, compare, and evaluate platforms — plus every related comparison.",
        },
      ]
    : []),
  ...relatedGuides
    .filter((g) => g.slug !== PLATFORMS_PILLAR_SLUG)
    .map((g) => ({
      href: guideHref(g.slug),
      title: guideLinkLabel(g.slug),
      excerpt: g.excerpt,
    })),
  {
    href: methodologyLink.href,
    title: methodologyLink.title,
    excerpt: methodologyLink.excerpt,
  },
];

const pageTitle = `${resolved.name} AI Agent Platforms`;
const pageDescription = `${resolved.description} Compare ${toolsInCategory.length} scored platforms in the ${resolved.name} category.`;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={`/categories/${resolved.slug}/`}
  breadcrumbs={[
    { name: "Home", path: "/" },
    { name: "Categories", path: "/categories/" },
    { name: resolved.name, path: `/categories/${resolved.slug}/` },
  ]}
>
  <!-- Header -->
  <section class="page-hero">
    <div class="page-hero-glow" aria-hidden="true"></div>

    <div class="container-site relative py-11 sm:py-14">
      <Breadcrumb
        items={[
          { label: "Home", href: "/" },
          { label: "Categories", href: "/categories/" },
          { label: resolved.name },
        ]}
      />

      <div
        class="mt-8 flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between"
      >
        <div class="max-w-2xl">
          <div class="flex items-center gap-3">
            <span
              class="flex h-11 w-11 items-center justify-center rounded-[var(--radius-lg)] bg-accent-soft text-sm font-bold text-accent ring-1 ring-accent/10"
              aria-hidden="true"
            >
              {resolved.icon}
            </span>
            <p class="eyebrow">Category</p>
          </div>

          <h1 class="text-page-title mt-4">
            {resolved.name}
          </h1>
          <p class="text-body-lg mt-3.5 max-w-xl">
            {resolved.description}
          </p>
          {
            showPlatformsPillar && platformsPillar && (
              <p class="mt-4 max-w-xl text-sm leading-relaxed text-ink-muted">
                New to the market? Start with the{" "}
                <a
                  href={guideHref(platformsPillar.slug)}
                  class="font-semibold text-accent hover:text-accent-hover"
                >
                  AI Agent Platforms Guide 2026
                </a>{" "}
                — then shortlist tools in this category.
              </p>
            )
          }
        </div>

        <div
          class="flex shrink-0 flex-col items-start gap-1 rounded-[var(--radius-xl)] border border-border bg-surface px-5 py-4 shadow-(--shadow-xs) sm:items-end"
        >
          <span class="eyebrow-muted">Platforms</span>
          <span class="text-2xl font-bold tabular-nums tracking-tight text-ink">
            {toolsInCategory.length}
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured guide for this category (prefer platforms pillar when relevant) -->
  {
    (showPlatformsPillar && platformsPillar
      ? platformsPillar
      : featuredGuide) && (
      <section class="border-b border-border bg-surface-muted">
        <div class="container-site py-8 sm:py-10">
          {
            (() => {
              const primary =
                showPlatformsPillar && platformsPillar
                  ? platformsPillar
                  : featuredGuide!;
              const chipLinks = relatedGuides
                .filter((g) => g.slug !== primary.slug)
                .slice(0, 5);
              return (
                <>
                  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
                    <div class="max-w-2xl">
                      <p class="eyebrow">
                        {primary.slug === PLATFORMS_PILLAR_SLUG
                          ? "Start here · Pillar hub"
                          : "Featured guide"}
                      </p>
                      <h2 class="mt-2 text-lg font-semibold tracking-tight text-ink sm:text-xl">
                        <a
                          href={guideHref(primary.slug)}
                          class="hover:text-accent"
                        >
                          {primary.title}
                        </a>
                      </h2>
                      <p class="mt-2 text-sm leading-relaxed text-ink-muted">
                        {primary.excerpt}
                      </p>
                    </div>
                    <a
                      href={guideHref(primary.slug)}
                      class="btn-secondary shrink-0 self-start sm:self-center"
                    >
                      {primary.slug === PLATFORMS_PILLAR_SLUG
                        ? "Open platforms guide →"
                        : "Read guide →"}
                    </a>
                  </div>
                  {chipLinks.length > 0 && (
                    <ul class="mt-6 flex flex-wrap gap-2 border-t border-border pt-5">
                      {chipLinks.map((g) => (
                        <li>
                          <a
                            href={guideHref(g.slug)}
                            class="inline-flex items-center rounded-full border border-border bg-surface px-3.5 py-1.5 text-sm font-medium text-ink-muted transition-colors hover:border-accent/30 hover:bg-accent-soft hover:text-accent"
                          >
                            {guideLinkLabel(g.slug)}
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}
                </>
              );
            })()
          }
        </div>
      </section>
    )
  }

  <!-- Tool grid + sort -->
  <section class="bg-surface">
    <div class="container-site section-y">
      <div
        class="mb-7 flex flex-col gap-4 sm:mb-8 sm:flex-row sm:items-center sm:justify-between"
      >
        <div>
          <h2 class="text-lg font-semibold tracking-tight text-ink">
            Platforms in {resolved.name}
          </h2>
          <p class="mt-1 text-sm text-ink-muted">
            Sorted by score by default. Switch to name anytime.
          </p>
        </div>

        <div class="flex items-center gap-2.5">
          <label
            for="sort-tools"
            class="text-sm font-medium text-ink-muted"
          >
            Sort by
          </label>
          <select
            id="sort-tools"
            name="sort"
            class="min-w-[11.5rem] rounded-[var(--radius-md)] border border-border bg-surface py-2.5 pl-3.5 pr-9 text-sm font-medium text-ink shadow-(--shadow-xs) transition-colors focus:border-accent/40 focus:outline-none focus:ring-0"
            data-sort-select
          >
            <option value="score">Score (high → low)</option>
            <option value="name">Name (A → Z)</option>
          </select>
        </div>
      </div>

      {
        toolsInCategory.length === 0 ? (
          <div class="empty-panel">
            <p class="text-base font-semibold text-ink">
              No platforms in this category yet
            </p>
            <p class="mt-2 max-w-sm text-sm text-ink-muted">
              Check back soon, or explore another category.
            </p>
            <a href="/categories/" class="btn-primary mt-6">
              Browse all categories
            </a>
          </div>
        ) : (
          <div
            class="grid auto-rows-fr gap-4 sm:grid-cols-2 sm:gap-5 lg:grid-cols-3 lg:gap-6"
            data-tool-grid
          >
            {toolsInCategory.map((tool) => (
              <ToolCard tool={tool} maxTags={4} />
            ))}
          </div>
        )
      }

      <!-- Sibling categories for easy navigation -->
      {
        otherCategories.length > 0 && (
          <div class="mt-12 border-t border-border pt-10 sm:mt-14 sm:pt-12">
            <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
              <h2 class="text-sm font-semibold text-ink">Other categories</h2>
              <a
                href="/platforms/"
                class="text-sm font-semibold text-accent hover:text-accent-hover"
              >
                View all platforms →
              </a>
            </div>
            <ul class="mt-4 flex flex-wrap gap-2">
              {otherCategories.map((c) => (
                <li>
                  <a
                    href={categoryHref(c)}
                    class="inline-flex items-center gap-1.5 rounded-full border border-border bg-surface-muted px-3.5 py-1.5 text-sm font-medium text-ink-muted transition-colors hover:border-accent/30 hover:bg-accent-soft hover:text-accent"
                  >
                    <span aria-hidden="true">{c.icon}</span>
                    {c.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </section>

  <RelatedLinks
    variant="section"
    eyebrow="Guides & comparisons"
    title={`Helpful reading for ${resolved.name}`}
    links={relatedLinks}
  />

  <!-- Bottom CTA -->
  <section class="section-cta border-t border-transparent">
    <div
      class="section-cta-glow"
      aria-hidden="true"
    >
    </div>
    <div
      class="container-site relative flex flex-col items-start gap-6 py-12 sm:flex-row sm:items-center sm:justify-between sm:py-14"
    >
      <div class="max-w-xl">
        <p
          class="text-[11px] font-semibold uppercase tracking-[0.16em] text-white/80"
        >
          Implementation
        </p>
        <h2
          class="mt-2 text-xl font-bold tracking-tight sm:text-2xl sm:leading-snug"
        >
          Need help implementing any of these agents?
        </h2>
        <p class="mt-2 text-sm leading-relaxed text-white/85 sm:text-base">
          We design, build, and ship production AI agent systems — from
          platform selection through secure deployment and ops.
        </p>
      </div>
      <div class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
        <a
          href={site.cta.href}
          class="inline-flex items-center justify-center rounded-[var(--radius-pill)] bg-white px-6 py-3.5 text-sm font-semibold text-accent shadow-(--shadow-md) transition-[transform,box-shadow] duration-150 hover:shadow-(--shadow-lg) active:scale-[0.98]"
          rel="noopener noreferrer"
        >
          Talk about implementation
        </a>
        <a
          href="/platforms/"
          class="inline-flex items-center justify-center rounded-[var(--radius-pill)] border border-white/35 bg-white/10 px-6 py-3.5 text-sm font-semibold text-white transition-colors hover:border-white/55 hover:bg-white/15"
        >
          All platforms
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const select = document.querySelector<HTMLSelectElement>("[data-sort-select]");
  const grid = document.querySelector<HTMLElement>("[data-tool-grid]");

  if (select && grid) {
    const sortCards = () => {
      const mode = select.value;
      const cards = Array.from(
        grid.querySelectorAll<HTMLElement>("[data-tool-card]"),
      );

      cards.sort((a, b) => {
        if (mode === "name") {
          return (a.dataset.name ?? "").localeCompare(b.dataset.name ?? "");
        }
        return Number(b.dataset.score ?? 0) - Number(a.dataset.score ?? 0);
      });

      for (const card of cards) {
        grid.appendChild(card);
      }
    };

    select.addEventListener("change", sortCards);
  }
</script>
