---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ToolCard from "../../components/ToolCard.astro";
import {
  categories,
  getCategoryBySlug,
} from "../../data/categories";
import { getToolsByCategory } from "../../data/tools";
import { site } from "../../data/site";
import type { Tool } from "../../types/tool";

export function getStaticPaths() {
  return categories.map((category) => ({
    params: { slug: category.slug },
  }));
}

const { slug } = Astro.params;
const category = getCategoryBySlug(slug!);

if (!category) {
  return Astro.redirect("/categories/");
}

const toolsInCategory: Tool[] = getToolsByCategory(category.id).sort(
  (a, b) => b.scores.overall - a.scores.overall,
);

const pageTitle = `${category.name} AI agent platforms`;
const pageDescription = `${category.description} Compare ${toolsInCategory.length} platforms in the ${category.name} category.`;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- Header band -->
  <section class="border-b border-border bg-surface-muted">
    <div class="container-site py-8 sm:py-10">
      <Breadcrumb
        items={[
          { label: "Home", href: "/" },
          { label: "Categories", href: "/categories/" },
          { label: category.name },
        ]}
      />

      <div class="mt-6 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div class="max-w-2xl">
          <div class="flex items-center gap-3">
            <span
              class="flex h-10 w-10 items-center justify-center rounded-lg bg-accent-soft text-sm font-bold text-accent"
              aria-hidden="true"
            >
              {category.icon}
            </span>
            <p
              class="text-xs font-semibold uppercase tracking-[0.14em] text-accent"
            >
              Category
            </p>
          </div>
          <h1
            class="mt-3 text-3xl font-bold tracking-tight text-ink sm:text-4xl"
          >
            {category.name}
          </h1>
          <p class="mt-3 text-base leading-relaxed text-ink-muted sm:text-lg">
            {category.description}
          </p>
        </div>

        <p class="shrink-0 text-sm font-medium tabular-nums text-ink-soft">
          <span class="text-ink">{toolsInCategory.length}</span>
          {
            toolsInCategory.length === 1
              ? "platform"
              : "platforms"
          }
        </p>
      </div>
    </div>
  </section>

  <!-- Tool grid + sort -->
  <section class="bg-surface">
    <div class="container-site py-8 sm:py-10">
      <div
        class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between"
      >
        <h2 class="text-sm font-semibold text-ink">
          Platforms in {category.name}
        </h2>

        <div class="flex items-center gap-2">
          <label
            for="sort-tools"
            class="text-sm font-medium text-ink-muted"
          >
            Sort by
          </label>
          <select
            id="sort-tools"
            name="sort"
            class="rounded-lg border border-border bg-surface py-2 pl-3 pr-8 text-sm font-medium text-ink shadow-(--shadow-sm) focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20"
            data-sort-select
          >
            <option value="score">Score (high → low)</option>
            <option value="name">Name (A → Z)</option>
          </select>
        </div>
      </div>

      {
        toolsInCategory.length === 0 ? (
          <p class="rounded-xl border border-dashed border-border bg-surface-muted px-6 py-12 text-center text-sm text-ink-muted">
            No platforms in this category yet.{" "}
            <a href="/categories/" class="font-semibold text-accent hover:text-accent-hover">
              Browse all categories
            </a>
          </p>
        ) : (
          <div
            class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3"
            data-tool-grid
          >
            {toolsInCategory.map((tool) => (
              <ToolCard tool={tool} maxTags={4} />
            ))}
          </div>
        )
      }
    </div>
  </section>

  <!-- Implementation CTA -->
  <section class="border-t border-border bg-accent-soft">
    <div
      class="container-site flex flex-col items-start gap-5 py-10 sm:flex-row sm:items-center sm:justify-between sm:py-12"
    >
      <div class="max-w-xl">
        <h2 class="text-xl font-bold tracking-tight text-ink sm:text-2xl">
          Need help implementing {category.name.toLowerCase()} agents?
        </h2>
        <p class="mt-2 text-sm leading-relaxed text-ink-muted sm:text-base">
          We design, build, and ship production AI agent systems — from
          framework selection through secure deployment and ops.
        </p>
      </div>
      <a
        href={site.cta.href}
        class="btn-primary shrink-0 px-5 py-3"
        rel="noopener noreferrer"
      >
        Talk about implementation
      </a>
    </div>
  </section>
</BaseLayout>

<script>
  const select = document.querySelector<HTMLSelectElement>("[data-sort-select]");
  const grid = document.querySelector<HTMLElement>("[data-tool-grid]");

  if (select && grid) {
    select.addEventListener("change", () => {
      const mode = select.value;
      const cards = Array.from(
        grid.querySelectorAll<HTMLElement>("[data-tool-card]"),
      );

      cards.sort((a, b) => {
        if (mode === "name") {
          return (a.dataset.name ?? "").localeCompare(b.dataset.name ?? "");
        }
        // score: high → low
        return (
          Number(b.dataset.score ?? 0) - Number(a.dataset.score ?? 0)
        );
      });

      for (const card of cards) {
        grid.appendChild(card);
      }
    });
  }
</script>
