---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ToolCard from "../../components/ToolCard.astro";
import {
  categories,
  getCategoryBySlug,
  categoryHref,
} from "../../data/categories";
import { getToolsByCategory } from "../../data/tools";
import { site } from "../../data/site";
import type { Tool } from "../../types/tool";

/** Static paths for the six supported category slugs. */
export function getStaticPaths() {
  return categories.map((category) => ({
    params: { slug: category.slug },
    props: { category },
  }));
}

interface Props {
  category: NonNullable<ReturnType<typeof getCategoryBySlug>>;
}

const { category } = Astro.props;
const { slug } = Astro.params;

// Safety: only known slugs are generated; double-check for typos
const resolved = getCategoryBySlug(slug ?? "") ?? category;

const toolsInCategory: Tool[] = getToolsByCategory(resolved.id).sort(
  (a, b) => b.scores.overall - a.scores.overall,
);

const otherCategories = categories.filter((c) => c.slug !== resolved.slug);

const pageTitle = `${resolved.name} AI agent platforms`;
const pageDescription = `${resolved.description} Compare ${toolsInCategory.length} platforms in the ${resolved.name} category.`;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- Header -->
  <section
    class="relative overflow-hidden border-b border-border bg-surface-muted"
  >
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_70%_50%_at_0%_0%,_var(--color-accent-soft)_0%,_transparent_55%)]"
      aria-hidden="true"
    >
    </div>

    <div class="container-site relative py-10 sm:py-12">
      <Breadcrumb
        items={[
          { label: "Home", href: "/" },
          { label: "Categories", href: "/categories/" },
          { label: resolved.name },
        ]}
      />

      <div
        class="mt-7 flex flex-col gap-6 sm:mt-8 sm:flex-row sm:items-end sm:justify-between"
      >
        <div class="max-w-2xl">
          <div class="flex items-center gap-3">
            <span
              class="flex h-11 w-11 items-center justify-center rounded-xl bg-accent-soft text-sm font-bold text-accent ring-1 ring-accent/10"
              aria-hidden="true"
            >
              {resolved.icon}
            </span>
            <p
              class="text-[11px] font-semibold uppercase tracking-[0.16em] text-accent"
            >
              Category
            </p>
          </div>

          <h1
            class="mt-4 text-3xl font-bold tracking-tight text-ink sm:text-4xl sm:leading-tight"
          >
            {resolved.name}
          </h1>
          <p
            class="mt-3 max-w-xl text-base leading-relaxed text-ink-muted sm:text-lg"
          >
            {resolved.description}
          </p>
        </div>

        <div
          class="flex shrink-0 flex-col items-start gap-1 rounded-2xl border border-border bg-surface px-5 py-4 shadow-(--shadow-sm) sm:items-end"
        >
          <span class="text-[11px] font-semibold uppercase tracking-wider text-ink-soft">
            Platforms
          </span>
          <span class="text-2xl font-bold tabular-nums tracking-tight text-ink">
            {toolsInCategory.length}
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- Tool grid + sort -->
  <section class="bg-surface">
    <div class="container-site section-y">
      <div
        class="mb-7 flex flex-col gap-4 sm:mb-8 sm:flex-row sm:items-center sm:justify-between"
      >
        <div>
          <h2 class="text-lg font-semibold tracking-tight text-ink">
            Platforms in {resolved.name}
          </h2>
          <p class="mt-1 text-sm text-ink-muted">
            Sorted by score by default. Switch to name anytime.
          </p>
        </div>

        <div class="flex items-center gap-2.5">
          <label
            for="sort-tools"
            class="text-sm font-medium text-ink-muted"
          >
            Sort by
          </label>
          <select
            id="sort-tools"
            name="sort"
            class="min-w-[11.5rem] rounded-xl border border-border bg-surface py-2.5 pl-3.5 pr-9 text-sm font-medium text-ink shadow-(--shadow-sm) transition-colors focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20"
            data-sort-select
          >
            <option value="score">Score (high → low)</option>
            <option value="name">Name (A → Z)</option>
          </select>
        </div>
      </div>

      {
        toolsInCategory.length === 0 ? (
          <div class="empty-panel">
            <p class="text-base font-semibold text-ink">
              No platforms in this category yet
            </p>
            <p class="mt-2 max-w-sm text-sm text-ink-muted">
              Check back soon, or explore another category.
            </p>
            <a href="/categories/" class="btn-primary mt-6">
              Browse all categories
            </a>
          </div>
        ) : (
          <div
            class="grid auto-rows-fr gap-4 sm:grid-cols-2 sm:gap-5 lg:grid-cols-3"
            data-tool-grid
          >
            {toolsInCategory.map((tool) => (
              <ToolCard tool={tool} maxTags={4} />
            ))}
          </div>
        )
      }

      <!-- Sibling categories for easy navigation -->
      {
        otherCategories.length > 0 && (
          <div class="mt-12 border-t border-border pt-10 sm:mt-14 sm:pt-12">
            <h2 class="text-sm font-semibold text-ink">Other categories</h2>
            <ul class="mt-4 flex flex-wrap gap-2">
              {otherCategories.map((c) => (
                <li>
                  <a
                    href={categoryHref(c)}
                    class="inline-flex items-center gap-1.5 rounded-full border border-border bg-surface-muted px-3.5 py-1.5 text-sm font-medium text-ink-muted transition-colors hover:border-accent/30 hover:bg-accent-soft hover:text-accent"
                  >
                    <span aria-hidden="true">{c.icon}</span>
                    {c.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="relative overflow-hidden border-t border-border bg-ink text-accent-fg">
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_rgb(79_70_229_/_0.22)_0%,_transparent_55%)]"
      aria-hidden="true"
    >
    </div>
    <div
      class="container-site relative flex flex-col items-start gap-6 py-12 sm:flex-row sm:items-center sm:justify-between sm:py-14"
    >
      <div class="max-w-xl">
        <p
          class="text-[11px] font-semibold uppercase tracking-[0.16em] text-indigo-300"
        >
          Implementation
        </p>
        <h2
          class="mt-2 text-xl font-bold tracking-tight sm:text-2xl sm:leading-snug"
        >
          Need help implementing any of these agents?
        </h2>
        <p class="mt-2 text-sm leading-relaxed text-slate-300 sm:text-base">
          We design, build, and ship production AI agent systems — from
          platform selection through secure deployment and ops.
        </p>
      </div>
      <div class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
        <a
          href={site.cta.href}
          class="inline-flex items-center justify-center rounded-xl bg-accent px-6 py-3.5 text-sm font-semibold text-accent-fg shadow-(--shadow-md) transition-[background-color,transform] duration-150 hover:bg-accent-hover active:scale-[0.98]"
          rel="noopener noreferrer"
        >
          Talk about implementation
        </a>
        <a
          href="/compare/"
          class="inline-flex items-center justify-center rounded-xl border border-slate-600 px-6 py-3.5 text-sm font-semibold text-white transition-colors hover:border-slate-400 hover:bg-white/5"
        >
          Compare platforms
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const select = document.querySelector<HTMLSelectElement>("[data-sort-select]");
  const grid = document.querySelector<HTMLElement>("[data-tool-grid]");

  if (select && grid) {
    const sortCards = () => {
      const mode = select.value;
      const cards = Array.from(
        grid.querySelectorAll<HTMLElement>("[data-tool-card]"),
      );

      cards.sort((a, b) => {
        if (mode === "name") {
          return (a.dataset.name ?? "").localeCompare(b.dataset.name ?? "");
        }
        return Number(b.dataset.score ?? 0) - Number(a.dataset.score ?? 0);
      });

      for (const card of cards) {
        grid.appendChild(card);
      }
    };

    select.addEventListener("change", sortCards);
  }
</script>
