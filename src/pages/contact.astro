---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import { site } from "../data/site";

const title = "Contact Zoetic AI";
const description = `Contact Zoetic AI for platform submissions, profile corrections, partnerships, and implementation inquiries. Email ${site.email}.`;
---

<BaseLayout
  title={title}
  description={description}
  canonical="/contact/"
  breadcrumbs={[
    { name: "Home", path: "/" },
    { name: "Contact", path: "/contact/" },
  ]}
>
  <section
    class="relative overflow-hidden border-b border-border bg-surface-muted"
  >
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_70%_50%_at_0%_0%,_var(--color-accent-soft)_0%,_transparent_55%)]"
      aria-hidden="true"
    >
    </div>
    <div class="container-site relative py-10 sm:py-12">
      <Breadcrumb
        items={[
          { label: "Home", href: "/" },
          { label: "Contact" },
        ]}
      />
      <h1
        class="mt-7 text-3xl font-bold tracking-tight text-ink sm:mt-8 sm:text-4xl sm:leading-tight"
      >
        Contact
      </h1>
      <p class="mt-3 max-w-2xl text-base leading-relaxed text-ink-muted sm:text-lg">
        Questions about a listing, a correction, or building agents in
        production? Send a note — we read every message.
      </p>
    </div>
  </section>

  <section class="bg-surface">
    <div class="container-site section-y">
      <div class="mx-auto grid max-w-5xl gap-10 lg:grid-cols-12 lg:gap-14">
        <!-- Side info -->
        <div class="lg:col-span-5">
          <h2 class="text-lg font-semibold tracking-tight text-ink">
            We welcome
          </h2>
          <ul class="mt-5 space-y-4">
            {
              [
                {
                  title: "Platform submissions",
                  body: "Suggest an AI agent platform that should be in the directory, with a public product URL.",
                },
                {
                  title: "Profile corrections",
                  body: "Pricing, feature flags, descriptions, or links that need an update — include a reference if you can.",
                },
                {
                  title: "Partnership & implementation",
                  body: "Shortlists, architecture reviews, or help shipping production agents with clear governance.",
                },
              ].map((item) => (
                <li class="card-surface p-5">
                  <h3 class="text-sm font-semibold text-ink">{item.title}</h3>
                  <p class="mt-1.5 text-sm leading-relaxed text-ink-muted">
                    {item.body}
                  </p>
                </li>
              ))
            }
          </ul>

          <div class="mt-8 rounded-2xl border border-border bg-surface-muted/60 p-5">
            <p
              class="text-xs font-semibold uppercase tracking-wider text-ink-soft"
            >
              Email
            </p>
            <a
              href={`mailto:${site.email}`}
              class="mt-2 inline-block text-base font-semibold text-accent hover:text-accent-hover"
            >
              {site.email}
            </a>
            <p class="mt-2 text-sm leading-relaxed text-ink-muted">
              Prefer email? Write us directly. For editorial notes, a public doc
              link or changelog helps us verify quickly.
            </p>
          </div>
        </div>

        <!-- Form -->
        <div class="lg:col-span-7">
          <div class="card-surface p-6 sm:p-8">
            <h2 class="text-lg font-semibold tracking-tight text-ink">
              Send a message
            </h2>
            <p class="mt-1.5 text-sm text-ink-muted">
              All fields required. Opens your email client with a drafted
              message — nothing is stored on this page.
            </p>

            <form class="mt-6 space-y-5" data-contact-form>
              <div>
                <label
                  for="contact-name"
                  class="block text-sm font-medium text-ink"
                >
                  Name
                </label>
                <input
                  id="contact-name"
                  name="name"
                  type="text"
                  required
                  autocomplete="name"
                  class="mt-1.5 w-full rounded-xl border border-border bg-surface px-3.5 py-2.5 text-sm text-ink shadow-(--shadow-sm) placeholder:text-ink-soft focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20"
                  placeholder="Your name"
                />
              </div>

              <div>
                <label
                  for="contact-email"
                  class="block text-sm font-medium text-ink"
                >
                  Email
                </label>
                <input
                  id="contact-email"
                  name="email"
                  type="email"
                  required
                  autocomplete="email"
                  class="mt-1.5 w-full rounded-xl border border-border bg-surface px-3.5 py-2.5 text-sm text-ink shadow-(--shadow-sm) placeholder:text-ink-soft focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20"
                  placeholder="you@company.com"
                />
              </div>

              <div>
                <label
                  for="contact-topic"
                  class="block text-sm font-medium text-ink"
                >
                  Topic
                </label>
                <select
                  id="contact-topic"
                  name="topic"
                  class="mt-1.5 w-full rounded-xl border border-border bg-surface px-3.5 py-2.5 text-sm font-medium text-ink shadow-(--shadow-sm) focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20"
                >
                  <option value="General">General</option>
                  <option value="Platform submission">Platform submission</option>
                  <option value="Profile correction">Profile correction</option>
                  <option value="Partnership / implementation">
                    Partnership / implementation
                  </option>
                </select>
              </div>

              <div>
                <label
                  for="contact-message"
                  class="block text-sm font-medium text-ink"
                >
                  Message
                </label>
                <textarea
                  id="contact-message"
                  name="message"
                  required
                  rows="6"
                  class="mt-1.5 w-full resize-y rounded-xl border border-border bg-surface px-3.5 py-2.5 text-sm text-ink shadow-(--shadow-sm) placeholder:text-ink-soft focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20"
                  placeholder="How can we help?"
                ></textarea>
              </div>

              <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                <button type="submit" class="btn-primary px-6 py-3">
                  Send message
                </button>
                <p class="text-xs text-ink-soft" data-contact-status aria-live="polite">
                </p>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ contactEmail: site.email }}>
  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
  const status = document.querySelector<HTMLElement>("[data-contact-status]");

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const name = String(data.get("name") ?? "").trim();
    const email = String(data.get("email") ?? "").trim();
    const topic = String(data.get("topic") ?? "General").trim();
    const message = String(data.get("message") ?? "").trim();

    if (!name || !email || !message) {
      if (status) status.textContent = "Please fill in all required fields.";
      return;
    }

    const subject = encodeURIComponent(`[${topic}] Message from ${name}`);
    const body = encodeURIComponent(
      `Name: ${name}\nEmail: ${email}\nTopic: ${topic}\n\n${message}`,
    );
    window.location.href = `mailto:${contactEmail}?subject=${subject}&body=${body}`;
    if (status) {
      status.textContent = "Opening your email app…";
    }
  });
</script>
