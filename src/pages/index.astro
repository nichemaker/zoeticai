---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import ToolCard from "../components/ToolCard.astro";
import { site } from "../data/site";
import {
  getFeaturedTools,
  getToolsByOverallScore,
  tools,
} from "../data/tools";
import { getCategoryCounts, categoryHref } from "../data/categories";
import { latestGuides } from "../data/guides";

const featuredRaw = getFeaturedTools(6);
/** Never leave the featured strip empty — fall back to top-scored tools. */
const featured =
  featuredRaw.length > 0 ? featuredRaw : getToolsByOverallScore(6);

const categoryCards = getCategoryCounts();
const catalogCount = tools.length || 0;
const guideList = latestGuides;

const whyItems = [
  {
    title: "Structured scores",
    body: "Overall rating plus six dimensions — capability, ease of use, integrations, enterprise, DX, and value.",
  },
  {
    title: "Feature-level filters",
    body: "Multi-agent, open source, self-host, MCP, and computer use flags you can scan at a glance.",
  },
  {
    title: "Buyer-ready categories",
    body: "Enterprise suites, frameworks, no-code, coding agents, browser control, and workflow automation.",
  },
  {
    title: "Compare-first design",
    body: "Listings and guides are written to help you shortlist and defend a choice with stakeholders.",
  },
];
---

<BaseLayout title="Home" description={site.description} isHome>
  <!-- 1. Hero -->
  <section
    class="relative overflow-hidden border-b border-border bg-surface-muted"
  >
    <div
      class="pointer-events-none absolute inset-0"
      aria-hidden="true"
    >
      <div
        class="absolute inset-0 bg-[radial-gradient(ellipse_80%_60%_at_50%_-10%,_var(--color-accent-soft)_0%,_transparent_60%)]"
      >
      </div>
      <div
        class="absolute inset-x-0 bottom-0 h-px bg-gradient-to-r from-transparent via-border to-transparent"
      >
      </div>
    </div>

    <div class="container-site relative section-y">
      <div class="mx-auto max-w-3xl text-center">
        <div
          class="inline-flex items-center gap-2 rounded-full border border-border bg-surface/80 px-3.5 py-1.5 text-[11px] font-semibold uppercase tracking-[0.14em] text-accent shadow-(--shadow-sm)"
        >
          <span
            class="h-1.5 w-1.5 rounded-full bg-accent"
            aria-hidden="true"
          ></span>
          AI agent platforms directory
        </div>

        <h1
          class="mt-6 text-[2.125rem] font-bold tracking-tight text-ink sm:text-5xl lg:text-[3.35rem] lg:leading-[1.08]"
        >
          Choose AI agent platforms with clarity
        </h1>

        <p
          class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-ink-muted sm:text-lg sm:leading-relaxed"
        >
          Independent profiles, scores, and comparisons across{" "}
          <span class="font-semibold text-ink">{catalogCount || "dozens of"}+</span
          >{" "}
          enterprise suites, frameworks, no-code builders, and coding agents —
          so you can shortlist with confidence.
        </p>

        <div
          class="mt-9 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center"
        >
          <a href="/platforms/" class="btn-primary px-7 py-3.5 text-base">
            Browse platforms
          </a>
          <a href="/compare/" class="btn-secondary px-7 py-3.5 text-base">
            Compare tools
          </a>
        </div>

        <ul
          class="mt-8 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-sm text-ink-soft"
        >
          <li class="inline-flex items-center gap-1.5">
            <span class="text-accent" aria-hidden="true">✓</span>
            Free to explore
          </li>
          <li class="inline-flex items-center gap-1.5">
            <span class="text-accent" aria-hidden="true">✓</span>
            Updated regularly
          </li>
          <li class="inline-flex items-center gap-1.5">
            <span class="text-accent" aria-hidden="true">✓</span>
            Built for buyers &amp; builders
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- 2. Featured Tools -->
  <section class="border-b border-border bg-surface">
    <div class="container-site section-y">
      <SectionHeader
        eyebrow="Featured"
        title="Featured platforms"
        description="A curated mix of high-signal tools across enterprise, frameworks, coding, and no-code."
        href="/platforms/"
        linkLabel="View all platforms"
      />

      {
        featured.length > 0 ? (
          <div class="-mx-4 flex gap-4 overflow-x-auto px-4 pb-3 snap-x snap-mandatory sm:mx-0 sm:grid sm:grid-cols-2 sm:gap-5 sm:overflow-visible sm:px-0 sm:pb-0 sm:snap-none lg:grid-cols-3">
            {featured.map((tool) => (
              <div class="w-[min(100%,19rem)] shrink-0 snap-start sm:w-auto sm:min-w-0 sm:shrink">
                <ToolCard tool={tool} featured maxTags={4} />
              </div>
            ))}
          </div>
        ) : (
          <div class="empty-panel">
            <p class="text-base font-semibold text-ink">Featured listings coming soon</p>
            <p class="mt-2 max-w-sm text-sm text-ink-muted">
              We are curating standout platforms for this strip.
            </p>
            <a href="/platforms/" class="btn-primary mt-6">
              Browse all platforms
            </a>
          </div>
        )
      }
    </div>
  </section>

  <!-- 3. Browse by Category -->
  <section class="border-b border-border bg-surface-muted">
    <div class="container-site section-y">
      <SectionHeader
        eyebrow="Categories"
        title="Browse by category"
        description="Start with how you buy and build — then drill into scored listings."
        href="/categories/"
        linkLabel="All categories"
      />

      {
        categoryCards.length > 0 ? (
          <div class="grid auto-rows-fr gap-4 sm:grid-cols-2 sm:gap-5 lg:grid-cols-3">
            {categoryCards.map(({ meta, count }) => (
              <a
                href={categoryHref(meta)}
                class="card-interactive group flex h-full min-h-[11.5rem] flex-col p-6 sm:p-7"
              >
                <div class="flex items-start justify-between gap-3">
                  <span
                    class="flex h-11 w-11 items-center justify-center rounded-xl bg-accent-soft text-sm font-bold text-accent ring-1 ring-accent/10 transition-transform duration-200 group-hover:scale-105"
                    aria-hidden="true"
                  >
                    {meta.icon}
                  </span>
                  <span class="rounded-full bg-surface px-2.5 py-1 text-[11px] font-semibold tabular-nums text-ink-soft ring-1 ring-border">
                    {count} {count === 1 ? "platform" : "platforms"}
                  </span>
                </div>

                <h3 class="mt-5 text-lg font-semibold tracking-tight text-ink transition-colors duration-150 group-hover:text-accent">
                  {meta.name}
                </h3>
                <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-muted">
                  {meta.description}
                </p>

                <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-accent">
                  Explore
                  <span
                    class="transition-transform duration-200 group-hover:translate-x-0.5"
                    aria-hidden="true"
                  >
                    →
                  </span>
                </span>
              </a>
            ))}
          </div>
        ) : (
          <div class="empty-panel">
            <p class="text-base font-semibold text-ink">Categories loading</p>
            <p class="mt-2 max-w-sm text-sm text-ink-muted">
              Category navigation will appear here once listings are available.
            </p>
          </div>
        )
      }
    </div>
  </section>

  <!-- 4. Why this directory -->
  <section class="border-b border-border bg-surface">
    <div class="container-site section-y">
      <div class="grid items-start gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5 lg:sticky lg:top-24">
          <p
            class="text-[11px] font-semibold uppercase tracking-[0.16em] text-accent"
          >
            Why this directory
          </p>
          <h2
            class="mt-2.5 text-2xl font-bold tracking-tight text-ink sm:text-[1.75rem] sm:leading-tight"
          >
            Built for decisions, not hype
          </h2>
          <p class="mt-4 text-base leading-relaxed text-ink-muted">
            The agent market moves fast. We organize platforms by how teams
            actually buy and ship — with comparable scores, clear features, and
            honest positioning — so you spend less time on vendor theater.
          </p>
        </div>

        <ul class="grid gap-4 sm:grid-cols-2 sm:gap-5 lg:col-span-7">
          {
            whyItems.map((item, i) => (
              <li class="card-interactive p-5 sm:p-6">
                <span
                  class="inline-flex h-7 w-7 items-center justify-center rounded-lg bg-accent-soft text-xs font-bold tabular-nums text-accent"
                  aria-hidden="true"
                >
                  {String(i + 1).padStart(2, "0")}
                </span>
                <h3 class="mt-3.5 text-base font-semibold text-ink">
                  {item.title}
                </h3>
                <p class="mt-2 text-sm leading-relaxed text-ink-muted">
                  {item.body}
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- 5. Latest Guides -->
  <section class="border-b border-border bg-surface-muted">
    <div class="container-site section-y">
      <SectionHeader
        eyebrow="Guides"
        title="Latest guides"
        description="Practical writing on evaluation, architecture choices, and shipping agents in production."
        href="/guides/"
        linkLabel="All guides"
      />

      {
        guideList.length > 0 ? (
          <div class="grid auto-rows-fr gap-4 md:grid-cols-3 md:gap-5">
            {guideList.map((guide) => (
              <article class="card-interactive group relative flex h-full min-h-[14rem] flex-col p-6 sm:p-7">
                <div class="flex items-center gap-2 text-[11px] font-semibold uppercase tracking-wider text-ink-soft">
                  <span class="rounded-md bg-accent-soft px-2 py-0.5 text-accent normal-case tracking-normal">
                    {guide.category}
                  </span>
                  <span aria-hidden="true" class="text-border-strong">
                    ·
                  </span>
                  <time datetime={guide.date} class="normal-case tracking-normal">
                    {guide.readTime} read
                  </time>
                </div>
                <h3 class="mt-4 text-lg font-semibold leading-snug tracking-tight text-ink transition-colors group-hover:text-accent">
                  <a
                    href={`/guides/${guide.slug}/`}
                    class="after:absolute after:inset-0 focus-visible:outline-none"
                  >
                    {guide.title}
                  </a>
                </h3>
                <p class="mt-2.5 flex-1 text-sm leading-relaxed text-ink-muted">
                  {guide.excerpt}
                </p>
                <span class="mt-5 text-sm font-semibold text-accent">
                  Read guide
                  <span
                    class="inline-block transition-transform duration-200 group-hover:translate-x-0.5"
                    aria-hidden="true"
                  >
                    {" "}
                    →
                  </span>
                </span>
              </article>
            ))}
          </div>
        ) : (
          <div class="empty-panel">
            <p class="text-base font-semibold text-ink">Guides on the way</p>
            <p class="mt-2 max-w-sm text-sm text-ink-muted">
              Evaluation playbooks and architecture notes will land here soon.
            </p>
          </div>
        )
      }
    </div>
  </section>

  <!-- 6. Final CTA banner -->
  <section class="relative overflow-hidden bg-ink text-accent-fg">
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_rgb(79_70_229_/_0.25)_0%,_transparent_55%)]"
      aria-hidden="true"
    >
    </div>
    <div class="container-site relative section-y">
      <div class="mx-auto flex max-w-2xl flex-col items-center text-center">
        <p
          class="text-[11px] font-semibold uppercase tracking-[0.16em] text-indigo-300"
        >
          Implementation
        </p>
        <h2
          class="mt-3 text-2xl font-bold tracking-tight sm:text-3xl sm:leading-tight"
        >
          Need production AI agents built?
        </h2>
        <p class="mt-4 max-w-xl text-base leading-relaxed text-slate-300">
          Beyond the directory — partner with a team that designs, ships, and
          operates agent systems for real products and enterprise workflows.
        </p>
        <div
          class="mt-9 flex w-full flex-col items-stretch gap-3 sm:w-auto sm:flex-row sm:items-center"
        >
          <a
            href={site.cta.href}
            class="inline-flex items-center justify-center rounded-xl bg-accent px-7 py-3.5 text-base font-semibold text-accent-fg shadow-(--shadow-md) transition-[background-color,transform] duration-150 hover:bg-accent-hover active:scale-[0.98]"
          >
            Talk to us
          </a>
          <a
            href="/categories/"
            class="inline-flex items-center justify-center rounded-xl border border-slate-600 bg-transparent px-7 py-3.5 text-base font-semibold text-white transition-colors duration-150 hover:border-slate-400 hover:bg-white/5"
          >
            Keep browsing
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
