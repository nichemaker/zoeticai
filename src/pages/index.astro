---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import ToolCard from "../components/ToolCard.astro";
import { site } from "../data/site";
import { getFeaturedTools, tools } from "../data/tools";
import { getCategoryCounts, categoryHref } from "../data/categories";
import { latestGuides } from "../data/guides";

const featured = getFeaturedTools(6);
const categoryCards = getCategoryCounts();
const catalogCount = tools.length;
---

<BaseLayout title="Home" description={site.description} isHome>
  <!-- 1. Hero -->
  <section class="relative overflow-hidden border-b border-border bg-surface-muted">
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--color-accent-soft)_0%,_transparent_55%)]"
      aria-hidden="true"
    >
    </div>
    <div class="container-site relative section-y">
      <div class="mx-auto max-w-3xl text-center">
        <p
          class="text-xs font-semibold uppercase tracking-[0.14em] text-accent"
        >
          AI agent platforms directory
        </p>
        <h1
          class="mt-4 text-4xl font-bold tracking-tight text-ink sm:text-5xl lg:text-[3.25rem] lg:leading-[1.1]"
        >
          Choose AI agent platforms with clarity
        </h1>
        <p
          class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-ink-muted sm:text-xl"
        >
          Independent profiles, scores, and comparisons across {catalogCount}+
          enterprise suites, frameworks, no-code builders, and coding agents —
          so you can shortlist with confidence.
        </p>

        <div
          class="mt-8 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center"
        >
          <a href="/categories/" class="btn-primary px-6 py-3 text-base">
            Browse platforms
          </a>
          <a href="/compare/" class="btn-secondary px-6 py-3 text-base">
            Compare tools
          </a>
        </div>

        <p class="mt-6 text-sm text-ink-soft">
          Free to explore · Updated regularly · Built for buyers &amp; builders
        </p>
      </div>
    </div>
  </section>

  <!-- 2. Featured Tools -->
  <section class="border-b border-border bg-surface">
    <div class="container-site section-y">
      <SectionHeader
        eyebrow="Featured"
        title="Featured platforms"
        description="A curated mix of high-signal tools across enterprise, frameworks, coding, and no-code."
        href="/categories/"
        linkLabel="View all platforms"
      />

      <!-- Mobile: horizontal scroll · md+: responsive grid -->
      <div
        class="-mx-4 flex gap-4 overflow-x-auto px-4 pb-2 snap-x snap-mandatory sm:mx-0 sm:grid sm:grid-cols-2 sm:overflow-visible sm:px-0 sm:pb-0 sm:snap-none lg:grid-cols-3"
      >
        {
          featured.map((tool) => (
            <div class="w-[min(100%,18.5rem)] shrink-0 snap-start sm:w-auto sm:shrink">
              <ToolCard tool={tool} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 3. Browse by Category -->
  <section class="border-b border-border bg-surface-muted">
    <div class="container-site section-y">
      <SectionHeader
        eyebrow="Categories"
        title="Browse by category"
        description="Start with how you buy and build — then drill into scored listings."
        href="/categories/"
        linkLabel="All categories"
      />

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          categoryCards.map(({ meta, count }) => (
            <a
              href={categoryHref(meta)}
              class="card-surface group flex flex-col p-6 transition-shadow duration-150 hover:shadow-(--shadow-md)"
            >
              <div class="flex items-center justify-between gap-3">
                <span
                  class="flex h-10 w-10 items-center justify-center rounded-lg bg-accent-soft text-sm font-bold text-accent"
                  aria-hidden="true"
                >
                  {meta.icon}
                </span>
                <span class="text-xs font-medium tabular-nums text-ink-soft">
                  {count} {count === 1 ? "platform" : "platforms"}
                </span>
              </div>
              <h3
                class="mt-4 text-lg font-semibold text-ink group-hover:text-accent"
              >
                {meta.name}
              </h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-muted">
                {meta.description}
              </p>
              <span
                class="mt-4 text-sm font-semibold text-accent"
                aria-hidden="true"
              >
                Explore →
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 4. Why this directory -->
  <section class="border-b border-border bg-surface">
    <div class="container-site section-y">
      <div class="grid items-start gap-10 lg:grid-cols-12 lg:gap-14">
        <div class="lg:col-span-5">
          <p
            class="text-xs font-semibold uppercase tracking-[0.14em] text-accent"
          >
            Why this directory
          </p>
          <h2
            class="mt-2 text-2xl font-bold tracking-tight text-ink sm:text-3xl"
          >
            Built for decisions, not hype
          </h2>
          <p class="mt-4 text-base leading-relaxed text-ink-muted">
            The agent market moves fast. We organize platforms by how teams
            actually buy and ship — with comparable scores, clear features, and
            honest positioning — so you spend less time on vendor theater.
          </p>
        </div>

        <ul class="grid gap-5 sm:grid-cols-2 lg:col-span-7">
          {
            [
              {
                title: "Structured scores",
                body: "Overall rating plus six dimensions — capability, ease of use, integrations, enterprise, DX, and value.",
              },
              {
                title: "Feature-level filters",
                body: "Multi-agent, open source, self-host, MCP, and computer use flags you can scan at a glance.",
              },
              {
                title: "Buyer-ready categories",
                body: "Enterprise suites, frameworks, no-code, coding agents, browser control, and workflow automation.",
              },
              {
                title: "Compare-first design",
                body: "Listings and guides are written to help you shortlist and defend a choice with stakeholders.",
              },
            ].map((item) => (
              <li class="card-surface p-5">
                <h3 class="text-base font-semibold text-ink">{item.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-ink-muted">
                  {item.body}
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- 5. Latest Guides -->
  <section class="border-b border-border bg-surface-muted">
    <div class="container-site section-y">
      <SectionHeader
        eyebrow="Guides"
        title="Latest guides"
        description="Practical writing on evaluation, architecture choices, and shipping agents in production."
        href="/guides/"
        linkLabel="All guides"
      />

      <div class="grid gap-4 md:grid-cols-3">
        {
          latestGuides.map((guide) => (
            <article class="card-surface flex h-full flex-col p-6">
              <div class="flex items-center gap-2 text-xs font-medium text-ink-soft">
                <span class="text-accent">{guide.category}</span>
                <span aria-hidden="true">·</span>
                <time datetime={guide.date}>{guide.readTime} read</time>
              </div>
              <h3 class="mt-3 text-lg font-semibold leading-snug text-ink">
                <a
                  href={`/guides/${guide.slug}/`}
                  class="hover:text-accent focus-visible:outline-none"
                >
                  {guide.title}
                </a>
              </h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-muted">
                {guide.excerpt}
              </p>
              <a
                href={`/guides/${guide.slug}/`}
                class="mt-4 text-sm font-semibold text-accent hover:text-accent-hover"
              >
                Read guide →
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 6. Final CTA banner -->
  <section class="bg-ink text-accent-fg">
    <div class="container-site section-y">
      <div
        class="mx-auto flex max-w-3xl flex-col items-center text-center"
      >
        <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">
          Need production AI agents built?
        </h2>
        <p class="mt-3 max-w-xl text-base leading-relaxed text-slate-300">
          Beyond the directory — partner with a team that designs, ships, and
          operates agent systems for real products and enterprise workflows.
        </p>
        <div
          class="mt-8 flex flex-col items-stretch gap-3 sm:flex-row sm:items-center"
        >
          <a
            href={site.cta.href}
            class="inline-flex items-center justify-center rounded-lg bg-accent px-6 py-3 text-base font-semibold text-accent-fg transition-colors hover:bg-accent-hover"
          >
            Talk to us
          </a>
          <a
            href="/categories/"
            class="inline-flex items-center justify-center rounded-lg border border-slate-600 bg-transparent px-6 py-3 text-base font-semibold text-white transition-colors hover:border-slate-400 hover:bg-white/5"
          >
            Keep browsing
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
