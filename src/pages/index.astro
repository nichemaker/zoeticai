---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import ToolCard from "../components/ToolCard.astro";
import { site } from "../data/site";
import {
  getFeaturedTools,
  getToolsByOverallScore,
  tools,
} from "../data/tools";
import { getCategoryCounts, categoryHref } from "../data/categories";
import {
  getLatestGuides,
  getGuideBySlug,
  getTopicHub,
  guideHref,
  HOMEPAGE_LATEST_GUIDES_COUNT,
} from "../data/guides";

const featuredRaw = getFeaturedTools(6);
/** Never leave the featured strip empty — fall back to top-scored tools. */
const featured =
  featuredRaw.length > 0 ? featuredRaw : getToolsByOverallScore(6);

const categoryCards = getCategoryCounts();
const catalogCount = tools.length || 0;
/** Newest-first subset for the homepage strip */
const guideList = getLatestGuides(HOMEPAGE_LATEST_GUIDES_COUNT);

const platformsPillar = getTopicHub("agent-platforms");
const platformsPillarPreview = getGuideBySlug(platformsPillar.slug);
const codingHub = getTopicHub("coding-agents");

/** High-signal comparisons called out near Latest guides */
const featuredComparisons = [
  {
    href: "/guides/lindy-vs-relevance-ai-vs-dust/",
    label: "Lindy vs Relevance AI vs Dust",
  },
  {
    href: "/guides/n8n-vs-make-vs-zapier-agents/",
    label: "n8n vs Make vs Zapier Agents",
  },
  {
    href: "/guides/claude-code-vs-cursor/",
    label: "Claude Code vs Cursor",
  },
  {
    href: "/guides/copilot-studio-vs-agentforce/",
    label: "Copilot Studio vs Agentforce",
  },
];

const whyItems = [
  {
    title: "Structured scores",
    body: "Overall rating plus six dimensions — capability, ease of use, integrations, enterprise, DX, and value.",
    href: "/methodology/",
    linkLabel: "See methodology",
  },
  {
    title: "Feature-level filters",
    body: "Multi-agent, open source, self-host, MCP, and computer use flags you can scan at a glance.",
    href: "/platforms/",
    linkLabel: "Filter platforms",
  },
  {
    title: "Buyer-ready categories",
    body: "Enterprise suites, frameworks, no-code, coding agents, browser control, and workflow automation.",
    href: "/categories/",
    linkLabel: "Browse categories",
  },
  {
    title: "Compare-first design",
    body: "Start from the AI Agent Platforms Guide, then open head-to-heads and roundups that match your decision.",
    href: guideHref(platformsPillar.slug),
    linkLabel: "AI Agent Platforms Guide",
  },
];
---

<BaseLayout
  title="AI Agent Platforms Directory"
  description={`${site.description} Independent scores, categories, and guides for buyers and builders.`}
  isHome
>
  <!-- 1. Hero -->
  <section class="page-hero">
    <div class="page-hero-glow" aria-hidden="true"></div>
    <div
      class="pointer-events-none absolute inset-x-0 bottom-0 h-px bg-gradient-to-r from-transparent via-border to-transparent"
      aria-hidden="true"
    >
    </div>

    <div class="container-site relative section-y">
      <div class="mx-auto max-w-3xl text-center">
        <div
          class="inline-flex items-center gap-2 rounded-full border border-border/90 bg-surface/90 px-3.5 py-1.5 text-[0.6875rem] font-semibold uppercase tracking-[0.12em] text-accent shadow-(--shadow-xs)"
        >
          <span
            class="h-1.5 w-1.5 rounded-full bg-accent"
            aria-hidden="true"
          ></span>
          AI agent platforms directory
        </div>

        <h1 class="text-display mt-7">
          Choose AI agent platforms with clarity
        </h1>

        <p class="text-body-lg mx-auto mt-5 max-w-2xl">
          Independent profiles, scores, and comparisons across{" "}
          <span class="font-semibold text-ink"
            >{catalogCount || "dozens of"}+</span
          >{" "}
          enterprise suites, frameworks, no-code builders, and coding agents —
          so you can shortlist with confidence.
        </p>

        <div
          class="mt-10 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center"
        >
          <a href="/platforms/" class="btn-primary px-7 py-3 text-[0.9375rem]">
            Browse platforms
          </a>
          <a
            href={guideHref(platformsPillar.slug)}
            class="btn-secondary px-7 py-3 text-[0.9375rem]"
          >
            Platforms guide
          </a>
        </div>

        <ul
          class="mt-9 flex flex-wrap items-center justify-center gap-x-6 gap-y-2.5 text-sm text-ink-soft"
        >
          <li>
            <a
              href="/methodology/"
              class="inline-flex items-center gap-2 transition-colors hover:text-ink"
            >
              <span
                class="flex h-4 w-4 items-center justify-center rounded-full bg-accent-soft text-[10px] font-bold text-accent"
                aria-hidden="true">✓</span
              >
              Transparent methodology
            </a>
          </li>
          <li>
            <a
              href="/about/"
              class="inline-flex items-center gap-2 transition-colors hover:text-ink"
            >
              <span
                class="flex h-4 w-4 items-center justify-center rounded-full bg-accent-soft text-[10px] font-bold text-accent"
                aria-hidden="true">✓</span
              >
              About Zoetic AI
            </a>
          </li>
          <li>
            <a
              href="/guides/"
              class="inline-flex items-center gap-2 transition-colors hover:text-ink"
            >
              <span
                class="flex h-4 w-4 items-center justify-center rounded-full bg-accent-soft text-[10px] font-bold text-accent"
                aria-hidden="true">✓</span
              >
              Practical guides
            </a>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- 2. Featured Tools -->
  <section class="border-b border-border bg-surface">
    <div class="container-site section-y">
      <SectionHeader
        eyebrow="Featured"
        title="Featured platforms"
        description="A curated mix of high-signal tools across enterprise, frameworks, coding, and no-code."
        href="/platforms/"
        linkLabel="View all platforms"
      />

      {
        featured.length > 0 ? (
          <div class="-mx-4 flex gap-4 overflow-x-auto px-4 pb-3 snap-x snap-mandatory sm:mx-0 sm:grid sm:grid-cols-2 sm:gap-5 sm:overflow-visible sm:px-0 sm:pb-0 sm:snap-none lg:grid-cols-3 lg:gap-6">
            {featured.map((tool) => (
              <div class="w-[min(100%,19rem)] shrink-0 snap-start sm:w-auto sm:min-w-0 sm:shrink">
                <ToolCard tool={tool} featured maxTags={4} />
              </div>
            ))}
          </div>
        ) : (
          <div class="empty-panel">
            <p class="text-base font-semibold text-ink">
              Featured listings coming soon
            </p>
            <p class="mt-2 max-w-sm text-sm text-ink-muted">
              We are curating standout platforms for this strip.
            </p>
            <a href="/platforms/" class="btn-primary mt-6">
              Browse all platforms
            </a>
          </div>
        )
      }
    </div>
  </section>

  <!-- 3. Browse by Category -->
  <section class="border-b border-border bg-surface-muted">
    <div class="container-site section-y">
      <SectionHeader
        eyebrow="Categories"
        title="Browse by category"
        description="Start with how you buy and build — then drill into scored listings."
        href="/categories/"
        linkLabel="All categories"
      />

      {
        categoryCards.length > 0 ? (
          <div class="grid auto-rows-fr gap-4 sm:grid-cols-2 sm:gap-5 lg:grid-cols-3 lg:gap-6">
            {categoryCards.map(({ meta, count }) => (
              <a
                href={categoryHref(meta)}
                class="card-interactive group flex h-full min-h-[12rem] flex-col p-6 sm:p-7"
              >
                <div class="flex items-start justify-between gap-3">
                  <span
                    class="flex h-11 w-11 items-center justify-center rounded-[var(--radius-lg)] bg-accent-soft text-sm font-bold text-accent ring-1 ring-accent/10"
                    aria-hidden="true"
                  >
                    {meta.icon}
                  </span>
                  <span class="rounded-full bg-surface px-2.5 py-1 text-[11px] font-semibold tabular-nums text-ink-soft ring-1 ring-border">
                    {count} {count === 1 ? "platform" : "platforms"}
                  </span>
                </div>

                <h3 class="mt-5 text-lg font-semibold tracking-tight text-ink transition-colors duration-150 group-hover:text-accent">
                  {meta.name}
                </h3>
                <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-muted">
                  {meta.description}
                </p>

                <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-accent">
                  Explore
                  <span
                    class="transition-transform duration-200 ease-[var(--ease-out-soft)] group-hover:translate-x-0.5"
                    aria-hidden="true"
                  >
                    →
                  </span>
                </span>
              </a>
            ))}
          </div>
        ) : (
          <div class="empty-panel">
            <p class="text-base font-semibold text-ink">Categories loading</p>
            <p class="mt-2 max-w-sm text-sm text-ink-muted">
              Category navigation will appear here once listings are available.
            </p>
          </div>
        )
      }
    </div>
  </section>

  <!-- 4. Why this directory -->
  <section class="border-b border-border bg-surface">
    <div class="container-site section-y">
      <div class="grid items-start gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5 lg:sticky lg:top-24">
          <p class="eyebrow">Why this directory</p>
          <h2 class="text-section-title mt-2.5">
            Built for decisions, not hype
          </h2>
          <p class="mt-4 text-base leading-relaxed text-ink-muted">
            The agent market moves fast. We organize platforms by how teams
            actually buy and ship — with comparable scores, clear features, and
            honest positioning — so you spend less time on vendor theater.
          </p>
          <p class="mt-5 text-sm text-ink-muted">
            Read{" "}
            <a
              href="/about/"
              class="font-semibold text-accent hover:text-accent-hover"
              >about Zoetic AI</a
            >{" "}
            or our full{" "}
            <a
              href="/methodology/"
              class="font-semibold text-accent hover:text-accent-hover"
              >scoring methodology</a
            >.
          </p>
        </div>

        <ul class="grid gap-4 sm:grid-cols-2 sm:gap-5 lg:col-span-7">
          {
            whyItems.map((item, i) => (
              <li class="card-interactive relative flex flex-col p-5 sm:p-6">
                <span
                  class="inline-flex h-7 w-7 items-center justify-center rounded-[var(--radius-sm)] bg-surface-muted text-[11px] font-bold tabular-nums text-ink-soft ring-1 ring-border"
                  aria-hidden="true"
                >
                  {String(i + 1).padStart(2, "0")}
                </span>
                <h3 class="mt-4 text-base font-semibold tracking-tight text-ink">
                  {item.title}
                </h3>
                <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-muted">
                  {item.body}
                </p>
                <a
                  href={item.href}
                  class="relative z-10 mt-4 text-sm font-semibold text-accent hover:text-accent-hover"
                >
                  {item.linkLabel} →
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- 5. Latest Guides -->
  <section class="border-b border-border bg-surface-muted">
    <div class="container-site section-y">
      <SectionHeader
        eyebrow="Guides"
        title="Latest guides"
        description="Start with the platforms pillar, then open newest roundups, TCO models, and head-to-head comparisons."
        href="/guides/"
        linkLabel="All guides"
      />

      {
        platformsPillarPreview && (
          <div class="mb-8 rounded-2xl border border-accent/20 bg-surface p-6 shadow-(--shadow-xs) sm:p-8">
            <div class="flex flex-col gap-5 lg:flex-row lg:items-center lg:justify-between">
              <div class="max-w-2xl">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="pill-accent">Start here</span>
                  <span class="text-[11px] font-medium text-ink-soft">
                    Pillar hub · {platformsPillarPreview.readTime} read
                  </span>
                </div>
                <h3 class="mt-3 text-xl font-semibold tracking-tight text-ink sm:text-2xl">
                  <a
                    href={guideHref(platformsPillar.slug)}
                    class="hover:text-accent"
                  >
                    {platformsPillarPreview.title}
                  </a>
                </h3>
                <p class="mt-2 text-sm leading-relaxed text-ink-muted sm:text-base">
                  {platformsPillar.description} Also see the{" "}
                  <a
                    href={guideHref(codingHub.slug)}
                    class="font-semibold text-accent hover:text-accent-hover"
                  >
                    Best AI Coding Agents
                  </a>{" "}
                  hub for software-delivery tools.
                </p>
              </div>
              <a
                href={guideHref(platformsPillar.slug)}
                class="btn-primary shrink-0 self-start lg:self-center"
              >
                Open platforms guide →
              </a>
            </div>
          </div>
        )
      }

      {
        guideList.length > 0 ? (
          <div class="grid auto-rows-fr gap-4 md:grid-cols-2 md:gap-5 lg:grid-cols-3 lg:gap-6">
            {guideList.map((guide) => (
              <article class="card-interactive group relative flex h-full min-h-[13.5rem] flex-col p-6 sm:p-7">
                <div class="flex flex-wrap items-center gap-2 text-[11px] font-medium text-ink-soft">
                  <span class="pill-accent normal-case tracking-normal">
                    {guide.category}
                  </span>
                  <span aria-hidden="true" class="text-border-strong">
                    ·
                  </span>
                  <time datetime={guide.date} class="tracking-normal">
                    {guide.readTime} read
                  </time>
                </div>
                <h3 class="mt-4 text-lg font-semibold leading-snug tracking-tight text-ink transition-colors group-hover:text-accent">
                  <a
                    href={guideHref(guide.slug)}
                    class="after:absolute after:inset-0 focus-visible:outline-none"
                  >
                    {guide.title}
                  </a>
                </h3>
                <p class="mt-2.5 flex-1 text-sm leading-relaxed text-ink-muted">
                  {guide.excerpt}
                </p>
                <span class="mt-5 text-sm font-semibold text-accent">
                  Read guide
                  <span
                    class="inline-block transition-transform duration-200 ease-[var(--ease-out-soft)] group-hover:translate-x-0.5"
                    aria-hidden="true"
                  >
                    {" "}
                    →
                  </span>
                </span>
              </article>
            ))}
          </div>
        ) : (
          <div class="empty-panel">
            <p class="text-base font-semibold text-ink">Guides on the way</p>
            <p class="mt-2 max-w-sm text-sm text-ink-muted">
              Evaluation playbooks and architecture notes will land here soon.
            </p>
          </div>
        )
      }

      {
        featuredComparisons.length > 0 && (
          <div class="mt-10 border-t border-border pt-8">
            <p class="text-sm font-semibold text-ink">
              Popular comparisons
            </p>
            <p class="mt-1 max-w-2xl text-sm text-ink-muted">
              Head-to-head picks for no-code agents, workflow automation, coding
              tools, and enterprise suites.
            </p>
            <ul class="mt-4 flex flex-wrap gap-2">
              {featuredComparisons.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="inline-flex items-center rounded-full border border-border bg-surface px-3.5 py-1.5 text-sm font-medium text-ink-muted transition-colors hover:border-accent/30 hover:bg-accent-soft hover:text-accent"
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </section>

  <!-- 6. Final CTA banner -->
  <section class="relative overflow-hidden bg-ink text-accent-fg">
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_rgb(67_56_202_/_0.28)_0%,_transparent_55%)]"
      aria-hidden="true"
    >
    </div>
    <div class="container-site relative section-y">
      <div class="mx-auto flex max-w-2xl flex-col items-center text-center">
        <p class="text-[0.6875rem] font-semibold uppercase tracking-[0.14em] text-indigo-300">
          Implementation
        </p>
        <h2
          class="mt-3 text-2xl font-bold tracking-tight sm:text-3xl sm:leading-tight"
        >
          Need production AI agents built?
        </h2>
        <p class="mt-4 max-w-xl text-base leading-relaxed text-slate-300">
          Beyond the directory — partner with a team that designs, ships, and
          operates agent systems for real products and enterprise workflows.
        </p>
        <div
          class="mt-10 flex w-full flex-col items-stretch gap-3 sm:w-auto sm:flex-row sm:items-center"
        >
          <a
            href={site.cta.href}
            class="inline-flex items-center justify-center rounded-[var(--radius-md)] bg-accent px-7 py-3.5 text-[0.9375rem] font-semibold text-accent-fg shadow-(--shadow-md) transition-[background-color,transform] duration-200 hover:bg-accent-hover active:translate-y-px"
          >
            Talk to us
          </a>
          <a
            href="/contact/"
            class="inline-flex items-center justify-center rounded-[var(--radius-md)] border border-white/15 bg-transparent px-7 py-3.5 text-[0.9375rem] font-semibold text-white transition-colors duration-150 hover:border-white/30 hover:bg-white/5"
          >
            Contact us
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
