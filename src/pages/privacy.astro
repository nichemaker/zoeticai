---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import { site } from "../data/site";

const title = "Privacy";
const description = `Privacy information for ${site.name}.`;
---

<BaseLayout title={title} description={description} canonical="/privacy/">
  <section class="border-b border-border bg-surface-muted">
    <div class="container-site py-10 sm:py-12">
      <Breadcrumb
        items={[
          { label: "Home", href: "/" },
          { label: "Privacy" },
        ]}
      />
      <h1 class="mt-7 text-3xl font-bold tracking-tight text-ink sm:text-4xl">
        Privacy
      </h1>
      <p class="mt-3 max-w-2xl text-base leading-relaxed text-ink-muted">
        We keep this site simple: static content and optional contact via email.
      </p>
    </div>
  </section>
  <section class="bg-surface">
    <div class="container-site section-y">
      <div
        class="mx-auto max-w-2xl space-y-4 text-base leading-relaxed text-ink-muted"
      >
        <p>
          This directory is a static website. We do not require an account to
          browse listings or guides. Contact forms open your own email client;
          we do not store form fields on this site unless you later connect a
          third-party form backend.
        </p>
        <p>
          Standard web logs (for example, CDN or host access logs) may record IP
          addresses and request paths for security and reliability. We do not
          sell personal information.
        </p>
        <p>
          Questions?{" "}
          <a
            href="/contact/"
            class="font-medium text-accent hover:text-accent-hover"
            >Contact us</a
          >{" "}
          or write to{" "}
          <a
            href={`mailto:${site.email}`}
            class="font-medium text-accent hover:text-accent-hover"
            >{site.email}</a
          >.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
