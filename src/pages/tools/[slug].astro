<script>
  /** Sticky tab active state via IntersectionObserver */
  const tabLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>("[data-tab]"),
  );
  const sectionIds = tabLinks.map((a) => a.dataset.tab).filter(Boolean) as string[];

  const setActive = (id: string) => {
    for (const a of tabLinks) {
      a.dataset.active = a.dataset.tab === id ? "true" : "false";
    }
  };

  if (sectionIds.length && "IntersectionObserver" in window) {
    const ratios = new Map<string, number>();
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          ratios.set(entry.target.id, entry.intersectionRatio);
        }
        let bestId = sectionIds[0];
        let best = 0;
        for (const id of sectionIds) {
          const r = ratios.get(id) ?? 0;
          if (r > best) {
            best = r;
            bestId = id;
          }
        }
        if (best > 0) setActive(bestId);
      },
      {
        rootMargin: "-30% 0px -55% 0px",
        threshold: [0, 0.1, 0.25, 0.5, 0.75, 1],
      },
    );

    for (const id of sectionIds) {
      const el = document.getElementById(id);
      if (el) observer.observe(el);
    }

    // Initial from hash
    const hash = location.hash.replace("#", "");
    if (hash && sectionIds.includes(hash)) setActive(hash);
    else setActive(sectionIds[0]!);
  }

  /** Favorites (localStorage) */
  const favBtn = document.querySelector<HTMLButtonElement>("[data-favorite]");
  if (favBtn) {
    const slug = favBtn.dataset.tool ?? "";
    const key = "zoetic-favorites";
    const read = (): string[] => {
      try {
        return JSON.parse(localStorage.getItem(key) ?? "[]");
      } catch {
        return [];
      }
    };
    const write = (list: string[]) =>
      localStorage.setItem(key, JSON.stringify(list));
    const sync = () => {
      const on = read().includes(slug);
      favBtn.setAttribute("aria-pressed", String(on));
      favBtn.textContent = on ? "Saved to Favorites" : "Add to Favorites";
    };
    sync();
    favBtn.addEventListener("click", () => {
      const list = read();
      const i = list.indexOf(slug);
      if (i >= 0) list.splice(i, 1);
      else list.push(slug);
      write(list);
      sync();
    });
  }

  /** Share */
  const shareBtn = document.querySelector<HTMLButtonElement>("[data-share]");
  if (shareBtn) {
    shareBtn.addEventListener("click", async () => {
      const url = shareBtn.dataset.url ?? location.href;
      const title = shareBtn.dataset.title ?? document.title;
      try {
        if (navigator.share) {
          await navigator.share({ title, url });
        } else {
          await navigator.clipboard.writeText(url);
          const prev = shareBtn.textContent;
          shareBtn.textContent = "Link copied";
          setTimeout(() => {
            shareBtn.textContent = prev;
          }, 1600);
        }
      } catch {
        /* user cancelled */
      }
    });
  }
</script>
