---
/**
 * Tool detail page — statically generated for every entry in `src/data/tools.ts`.
 * URLs: /tools/{slug}/  (trailingSlash: always)
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ToolCard from "../../components/ToolCard.astro";
import HubBacklink from "../../components/HubBacklink.astro";
import {
  tools,
  getToolBySlug,
  getSimilarTools,
} from "../../data/tools";
import { categoryHref } from "../../data/categories";
import {
  getRelatedGuidesForTool,
  getPrimaryComparisonForTool,
  getHubsForTool,
  guideHref,
  guideLinkLabel,
  methodologyLink,
} from "../../data/guides";
import RelatedLinks from "../../components/RelatedLinks.astro";
import { site } from "../../data/site";
import type { Tool, ToolScores } from "../../types/tool";

/** Prerender every tool at build time (static + Cloudflare Workers assets). */
export const prerender = true;

export function getStaticPaths() {
  return tools.map((tool) => ({
    params: { slug: tool.slug },
    props: { tool },
  }));
}

interface Props {
  tool?: Tool;
}

const { tool: toolProp } = Astro.props;
const slugParam = Astro.params.slug ?? "";

// Resolve from props first, then catalog — never trust a missing slug.
const tool: Tool | undefined =
  toolProp ?? getToolBySlug(slugParam) ?? tools.find((t) => t.slug === slugParam);

if (!tool) {
  return Astro.redirect("/categories/");
}

const similar = getSimilarTools(tool, 4);
const relatedGuides = getRelatedGuidesForTool(tool);
const primaryComparison = getPrimaryComparisonForTool(tool.slug);
const toolHubs = getHubsForTool(tool.slug);
const relatedReading = [
  ...(primaryComparison
    ? [
        {
          href: guideHref(primaryComparison.slug),
          title: guideLinkLabel(primaryComparison.slug),
          excerpt: primaryComparison.excerpt,
        },
      ]
    : []),
  {
    href: methodologyLink.href,
    title: methodologyLink.title,
    excerpt: methodologyLink.excerpt,
  },
  ...relatedGuides
    .filter((g) => g.slug !== primaryComparison?.slug)
    .map((g) => ({
      href: guideHref(g.slug),
      title: guideLinkLabel(g.slug),
      excerpt: g.excerpt,
    })),
];

const scoreDimensions: {
  key: keyof Omit<ToolScores, "overall">;
  label: string;
  hint: string;
}[] = [
  {
    key: "capability",
    label: "Capability",
    hint: "Reasoning, tools, memory, autonomy",
  },
  {
    key: "easeOfUse",
    label: "Ease of use",
    hint: "Time to a useful first agent",
  },
  {
    key: "integrations",
    label: "Integrations",
    hint: "Connectors, APIs, ecosystem",
  },
  {
    key: "enterprise",
    label: "Enterprise",
    hint: "Security, admin, compliance",
  },
  {
    key: "developerExperience",
    label: "Developer experience",
    hint: "SDKs, docs, observability",
  },
  {
    key: "value",
    label: "Value",
    hint: "Price-to-capability fit",
  },
];

const featureBadges: {
  key: keyof Tool["features"];
  label: string;
}[] = [
  { key: "multiAgent", label: "Multi-agent" },
  { key: "openSource", label: "Open source" },
  { key: "selfHost", label: "Self-host" },
  { key: "mcpSupport", label: "MCP" },
  { key: "computerUse", label: "Computer use" },
];

const pricingLabels: Record<Tool["pricing"]["model"], string> = {
  free: "Free",
  freemium: "Freemium",
  paid: "Paid",
  usage: "Usage-based",
  enterprise: "Enterprise",
  "open-source": "Open source",
};

const initials = tool.name
  .split(/\s+/)
  .slice(0, 2)
  .map((w) => w[0])
  .join("")
  .toUpperCase();

const overall = tool.scores.overall.toFixed(1);
const primaryCategory = tool.categories[0];
const lastUpdatedLabel = new Date(
  tool.lastUpdated + "T00:00:00",
).toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});

let websiteHost = "Visit website";
try {
  websiteHost = new URL(tool.website).hostname.replace(/^www\./, "");
} catch {
  /* keep fallback */
}

const pageTitle = `${tool.name} — AI Agent Platform Review`;
const pageDescription = `${tool.tagline} Overall score ${overall}/10. ${tool.categories.join(", ")} · See features, pricing, and similar tools.`.slice(
  0,
  160,
);

const toolBreadcrumbs = [
  { name: "Home", path: "/" },
  ...(primaryCategory
    ? [{ name: primaryCategory, path: categoryHref(primaryCategory) }]
    : [{ name: "Platforms", path: "/platforms/" }]),
  { name: tool.name, path: `/tools/${tool.slug}/` },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={`/tools/${tool.slug}/`}
  breadcrumbs={toolBreadcrumbs}
  article={{ dateModified: tool.lastUpdated, datePublished: tool.lastUpdated }}
>
  <!-- Hero -->
  <section class="page-hero">
    <div class="page-hero-glow" aria-hidden="true"></div>

    <div class="container-site relative py-11 sm:py-14">
      <Breadcrumb
        items={[
          { label: "Home", href: "/" },
          {
            label: primaryCategory ?? "Categories",
            href: primaryCategory
              ? categoryHref(primaryCategory)
              : "/categories/",
          },
          { label: tool.name },
        ]}
      />

      {
        toolHubs.length > 0 && (
          <div class="mt-6 max-w-3xl">
            <HubBacklink toolSlug={tool.slug} />
          </div>
        )
      }

      <div
        class="mt-8 flex flex-col gap-8 lg:mt-9 lg:flex-row lg:items-start lg:justify-between lg:gap-12"
      >
        <div class="min-w-0 flex-1">
          <!-- Categories (clickable) -->
          <div class="flex flex-wrap items-center gap-2">
            {
              tool.categories.map((cat) => (
                <a href={categoryHref(cat)} class="pill">
                  {cat}
                </a>
              ))
            }
            {
              tool.featured && (
                <span class="pill-accent">Featured</span>
              )
            }
          </div>

          <div class="mt-6 flex items-start gap-4">
            <div
              class="avatar-mark h-14 w-14 text-base sm:h-16 sm:w-16 sm:text-lg"
              aria-hidden="true"
            >
              {initials}
            </div>
            <div class="min-w-0">
              <h1 class="text-page-title">
                {tool.name}
              </h1>
              <p class="text-body-lg mt-2.5">
                {tool.tagline}
              </p>
            </div>
          </div>

          <div class="mt-7 flex flex-wrap items-center gap-3">
            <a
              href={tool.website}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-primary px-5 py-3"
            >
              Visit website
              <span class="opacity-80" aria-hidden="true">↗</span>
            </a>
            <a href="/platforms/" class="btn-secondary px-5 py-3">
              Compare platforms
            </a>
          </div>

          <p class="mt-4 text-xs text-ink-soft">
            Last updated {lastUpdatedLabel}
            {
              websiteHost && (
                <>
                  {" · "}
                  <span class="text-ink-muted">{websiteHost}</span>
                </>
              )
            }
          </p>
        </div>

        <!-- Big overall score -->
        <div
          class="score-panel"
          aria-label={`Overall score ${overall} out of 10`}
        >
          <span class="eyebrow-muted">Overall score</span>
          <span
            class="mt-2 text-5xl font-bold tabular-nums tracking-tight text-ink sm:text-[3.5rem]"
          >
            {overall}
          </span>
          <span class="mt-1.5 text-sm font-medium text-ink-muted">out of 10</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Main content -->
  <section class="bg-surface">
    <div class="container-site section-y">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
        <!-- Left -->
        <div class="space-y-10 lg:col-span-7">
          <div>
            <h2 class="text-xl font-semibold tracking-tight text-ink">
              Overview
            </h2>
            <p class="mt-3.5 text-base leading-relaxed text-ink-muted">
              {tool.description}
            </p>
          </div>

          <!-- Score breakdown -->
          <div>
            <h2 class="text-xl font-semibold tracking-tight text-ink">
              Score breakdown
            </h2>
            <p class="mt-1.5 text-sm text-ink-muted">
              Editorial scores on a 0–10 scale across six buyer-relevant
              dimensions. See{" "}
              <a
                href="/methodology/"
                class="font-medium text-accent hover:text-accent-hover"
              >
                how we evaluate platforms
              </a>{" "}
              for the full rubric.
            </p>

            <ul class="mt-7 space-y-5">
              {
                scoreDimensions.map(({ key, label, hint }) => {
                  const value = tool.scores[key];
                  const pct = Math.max(0, Math.min(100, (value / 10) * 100));
                  return (
                    <li>
                      <div class="flex items-end justify-between gap-3">
                        <div>
                          <p class="text-sm font-semibold text-ink">{label}</p>
                          <p class="mt-0.5 text-xs text-ink-soft">{hint}</p>
                        </div>
                        <span class="text-sm font-bold tabular-nums tracking-tight text-ink">
                          {value.toFixed(1)}
                        </span>
                      </div>
                      <div
                        class="score-bar-track"
                        role="meter"
                        aria-valuenow={value}
                        aria-valuemin={0}
                        aria-valuemax={10}
                        aria-label={`${label}: ${value.toFixed(1)} of 10`}
                      >
                        <div
                          class="score-bar-fill"
                          style={`width: ${pct}%`}
                        />
                      </div>
                    </li>
                  );
                })
              }
            </ul>
          </div>

          <!-- Best for -->
          {
            tool.bestFor.length > 0 && (
              <div>
                <h2 class="text-lg font-semibold tracking-tight text-ink">
                  Best for
                </h2>
                <ul class="mt-4 flex flex-wrap gap-2">
                  {tool.bestFor.map((item) => (
                    <li>
                      <span class="inline-flex rounded-full border border-border bg-surface-muted px-3.5 py-1.5 text-sm font-medium text-ink-muted">
                        {item}
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
        </div>

        <!-- Sidebar -->
        <aside class="space-y-5 lg:col-span-5">
          <!-- Feature badges -->
          <div class="card-surface p-6 sm:p-7">
            <h2 class="text-base font-semibold tracking-tight text-ink">
              Key features
            </h2>
            <ul class="mt-5 flex flex-wrap gap-2">
              {
                featureBadges.map(({ key, label }) => {
                  const on = tool.features[key];
                  return (
                    <li>
                      <span
                        class:list={[
                          "inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 text-xs font-semibold",
                          on
                            ? "bg-accent-soft text-accent ring-1 ring-accent/12"
                            : "bg-surface-muted text-ink-soft ring-1 ring-border",
                        ]}
                      >
                        <span aria-hidden="true" class="opacity-70">
                          {on ? "✓" : "—"}
                        </span>
                        {label}
                        <span class="sr-only">{on ? "supported" : "not supported"}</span>
                      </span>
                    </li>
                  );
                })
              }
            </ul>
            <p class="mt-4 text-xs leading-relaxed text-ink-soft">
              Highlighted badges are supported; dimmed badges are not currently
              listed for this platform.
            </p>
          </div>

          <!-- Pricing -->
          <div class="card-surface p-6 sm:p-7">
            <h2 class="text-base font-semibold tracking-tight text-ink">
              Pricing
            </h2>
            <dl class="mt-5 space-y-4">
              <div>
                <dt
                  class="text-xs font-semibold uppercase tracking-wider text-ink-soft"
                >
                  Model
                </dt>
                <dd class="mt-1 text-sm font-semibold text-ink">
                  {pricingLabels[tool.pricing.model]}
                </dd>
              </div>
              {
                tool.pricing.startingPrice && (
                  <div>
                    <dt class="text-xs font-semibold uppercase tracking-wider text-ink-soft">
                      Starting at
                    </dt>
                    <dd class="mt-1 text-sm font-semibold text-ink">
                      {tool.pricing.startingPrice}
                    </dd>
                  </div>
                )
              }
              {
                tool.pricing.notes && (
                  <div>
                    <dt class="text-xs font-semibold uppercase tracking-wider text-ink-soft">
                      Notes
                    </dt>
                    <dd class="mt-1 text-sm leading-relaxed text-ink-muted">
                      {tool.pricing.notes}
                    </dd>
                  </div>
                )
              }
            </dl>
            <p class="mt-5 text-xs leading-relaxed text-ink-soft">
              Pricing is indicative and may change. Confirm on the vendor site.
            </p>
          </div>

          <!-- Website -->
          <div class="card-surface p-6 sm:p-7">
            <h2 class="text-base font-semibold tracking-tight text-ink">
              Official site
            </h2>
            <p class="mt-2 text-sm leading-relaxed text-ink-muted">
              Docs, plans, and the latest product releases.
            </p>
            <a
              href={tool.website}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-secondary mt-5 w-full"
            >
              {websiteHost}
              <span class="ml-1.5" aria-hidden="true">↗</span>
            </a>
          </div>

          <RelatedLinks
            title={
              primaryComparison
                ? "Comparisons & guides"
                : "Guides & methodology"
            }
            eyebrow="Learn more"
            links={relatedReading}
          />

          <div class="rounded-2xl border border-border p-5 sm:p-6">
            <p class="text-xs font-semibold uppercase tracking-wider text-ink-soft">
              Browse
            </p>
            <ul class="mt-3 space-y-2 text-sm">
              <li>
                <a
                  href="/platforms/"
                  class="font-medium text-accent hover:text-accent-hover"
                >
                  All platforms
                </a>
              </li>
              {
                tool.categories.map((cat) => (
                  <li>
                    <a
                      href={categoryHref(cat)}
                      class="font-medium text-ink-muted hover:text-accent"
                    >
                      More in {cat}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- Similar tools -->
  {
    similar.length > 0 && (
      <section class="border-t border-border bg-surface-muted">
        <div class="container-site section-y">
          <div class="mb-8 flex flex-col gap-2 sm:mb-10 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-accent">
                Related
              </p>
              <h2 class="mt-2 text-2xl font-bold tracking-tight text-ink sm:text-[1.75rem]">
                Similar tools
              </h2>
              <p class="mt-2 text-sm text-ink-muted sm:text-base">
                Platforms in overlapping categories with comparable scores.
              </p>
            </div>
            {primaryCategory && (
              <a
                href={categoryHref(primaryCategory)}
                class="text-sm font-semibold text-accent hover:text-accent-hover"
              >
                More in {primaryCategory} →
              </a>
            )}
          </div>

          <div class="grid auto-rows-fr gap-4 sm:grid-cols-2 sm:gap-5 lg:grid-cols-4">
            {similar.map((t) => (
              <ToolCard tool={t} maxTags={3} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Strong bottom CTA -->
  <section class="section-cta">
    <div
      class="section-cta-glow"
      aria-hidden="true"
    >
    </div>
    <div class="container-site relative section-y">
      <div class="mx-auto flex max-w-2xl flex-col items-center text-center">
        <p
          class="text-[11px] font-semibold uppercase tracking-[0.16em] text-white/80"
        >
          Implementation
        </p>
        <h2
          class="mt-3 text-2xl font-bold tracking-tight sm:text-3xl sm:leading-tight"
        >
          Need this agent implemented or customized?
        </h2>
        <p class="mt-4 max-w-xl text-base leading-relaxed text-white/85">
          We design, build, and ship production systems with platforms like{" "}
          {tool.name} — including governance, integrations, and ops your team
          can own.
        </p>
        <div
          class="mt-9 flex w-full flex-col items-stretch gap-3 sm:w-auto sm:flex-row sm:items-center"
        >
          <a
            href={site.cta.href}
            class="inline-flex items-center justify-center rounded-[var(--radius-pill)] bg-white px-7 py-3.5 text-base font-semibold text-accent shadow-(--shadow-md) transition-[transform,box-shadow] duration-150 hover:shadow-(--shadow-lg) active:scale-[0.98]"
            rel="noopener noreferrer"
          >
            Talk about implementation
          </a>
          <a
            href={
              primaryCategory ? categoryHref(primaryCategory) : "/categories/"
            }
            class="inline-flex items-center justify-center rounded-[var(--radius-pill)] border border-white/35 bg-white/10 px-7 py-3.5 text-base font-semibold text-white transition-colors duration-150 hover:border-white/55 hover:bg-white/15"
          >
            Back to category
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
