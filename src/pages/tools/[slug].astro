---
/**
 * Tool detail page — product-page layout matching the modern AI tools reference:
 * Hero card · sticky tabs · overview / features / pricing / reviews · sidebar · similar
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import HubBacklink from "../../components/HubBacklink.astro";
import SearchDemand from "../../components/tool/SearchDemand.astro";
import PeopleAlsoCompare from "../../components/tool/PeopleAlsoCompare.astro";
import {
  tools,
  getToolBySlug,
  getSimilarTools,
  getToolCompany,
  getCategoryRank,
  getPricingPlans,
} from "../../data/tools";
import { categoryHref } from "../../data/categories";
import {
  getRelatedGuidesForTool,
  getPrimaryComparisonForTool,
  getHubsForTool,
  guideHref,
  guideLinkLabel,
  methodologyLink,
} from "../../data/guides";
import { site } from "../../data/site";
import type { Tool, ToolScores } from "../../types/tool";

export const prerender = true;

export function getStaticPaths() {
  return tools.map((tool) => ({
    params: { slug: tool.slug },
    props: { tool },
  }));
}

interface Props {
  tool?: Tool;
}

const { tool: toolProp } = Astro.props;
const slugParam = Astro.params.slug ?? "";

const tool: Tool | undefined =
  toolProp ?? getToolBySlug(slugParam) ?? tools.find((t) => t.slug === slugParam);

if (!tool) {
  return Astro.redirect("/categories/");
}

const similar = getSimilarTools(tool, 4);
const relatedGuides = getRelatedGuidesForTool(tool);
const primaryComparison = getPrimaryComparisonForTool(tool.slug);
const toolHubs = getHubsForTool(tool.slug);
const company = getToolCompany(tool);
const categoryRank = getCategoryRank(tool);
const pricingPlans = getPricingPlans(tool);

const scoreDimensions: {
  key: keyof Omit<ToolScores, "overall">;
  label: string;
  hint: string;
}[] = [
  { key: "capability", label: "Capability", hint: "Reasoning, tools, memory, autonomy" },
  { key: "easeOfUse", label: "Ease of use", hint: "Time to a useful first agent" },
  { key: "integrations", label: "Integrations", hint: "Connectors, APIs, ecosystem" },
  { key: "enterprise", label: "Enterprise", hint: "Security, admin, compliance" },
  {
    key: "developerExperience",
    label: "Developer experience",
    hint: "SDKs, docs, observability",
  },
  { key: "value", label: "Value", hint: "Price-to-capability fit" },
];

const featureRows: {
  key: keyof Tool["features"];
  title: string;
  description: string;
  icon: string;
}[] = [
  {
    key: "multiAgent",
    title: "Multi-agent",
    description: "Coordinate multiple agents, roles, or handoffs in one system.",
    icon: "users",
  },
  {
    key: "openSource",
    title: "Open source",
    description: "Core product available under an open-source license.",
    icon: "code",
  },
  {
    key: "selfHost",
    title: "Self-host",
    description: "Deploy in your own cloud, VPC, or on-prem environment.",
    icon: "server",
  },
  {
    key: "mcpSupport",
    title: "MCP support",
    description: "Model Context Protocol or equivalent tool-server interoperability.",
    icon: "plug",
  },
  {
    key: "computerUse",
    title: "Computer use",
    description: "GUI / browser control for agents that operate software like a user.",
    icon: "monitor",
  },
];

const pricingLabels: Record<Tool["pricing"]["model"], string> = {
  free: "Free",
  freemium: "Freemium",
  paid: "Paid",
  usage: "Usage-based",
  enterprise: "Enterprise",
  "open-source": "Open source",
};

const initials = tool.name
  .split(/\s+/)
  .slice(0, 2)
  .map((w) => w[0])
  .join("")
  .toUpperCase();

const overall = tool.scores.overall.toFixed(1);
/** Display stars out of 5 from 0–10 score */
const starsOutOf5 = Math.round((tool.scores.overall / 2) * 10) / 10;
const primaryCategory = tool.categories[0];
const lastUpdatedLabel = new Date(
  tool.lastUpdated + "T00:00:00",
).toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});

let websiteHost = "Vendor site";
try {
  websiteHost = new URL(tool.website).hostname.replace(/^www\./, "");
} catch {
  /* keep fallback */
}

/** Hero description: first ~2 sentences of the editorial summary */
const heroDescription = (() => {
  const parts = tool.description.split(/(?<=[.!?])\s+/).filter(Boolean);
  return parts.slice(0, 2).join(" ");
})();

const overviewParagraphs = (() => {
  const parts = tool.description.split(/(?<=[.!?])\s+/).filter(Boolean);
  if (parts.length <= 3) return [tool.description];
  const mid = Math.ceil(parts.length / 2);
  return [parts.slice(0, mid).join(" "), parts.slice(mid).join(" ")];
})();

const badges: string[] = [];
if (tool.featured) badges.push("Featured");
if (tool.pricing.model === "free" || tool.pricing.model === "freemium") {
  badges.push(
    tool.pricing.model === "free" ? "Free plan available" : "Freemium",
  );
} else {
  badges.push(pricingLabels[tool.pricing.model]);
}
if (tool.features.openSource) badges.push("Open source");
if (tool.features.multiAgent) badges.push("Multi-agent");

/** Deterministic sample reviews (clearly labeled as samples). */
const sampleReviews = [
  {
    name: "Alex M.",
    role: "Engineering lead",
    stars: Math.min(5, Math.max(3, Math.round(tool.scores.overall / 2))),
    body: `${tool.name} fits our stack when we need ${tool.bestFor[0]?.toLowerCase() ?? "reliable agent workflows"}. Score reflects real pilot time, not a demo.`,
  },
  {
    name: "Priya S.",
    role: "Platform engineer",
    stars: Math.min(5, Math.max(3, Math.round(tool.scores.developerExperience / 2))),
    body: `DX is the differentiator for us — docs, tooling, and how fast we can ship a guarded agent with ${tool.name}.`,
  },
  {
    name: "Jordan K.",
    role: "Ops / automation",
    stars: Math.min(5, Math.max(3, Math.round(tool.scores.easeOfUse / 2))),
    body: `We evaluated ${tool.name} against peers in ${primaryCategory ?? "this category"}. Worth a structured pilot with golden tasks.`,
  },
];

const tabs = [
  { id: "overview", label: "Overview" },
  { id: "features", label: "Features" },
  { id: "pricing", label: "Pricing" },
  { id: "reviews", label: "Reviews" },
  { id: "alternatives", label: "Alternatives" },
] as const;

const pageTitle = `${tool.name} — AI Agent Platform Review`;
const pageDescription = `${tool.tagline} Overall score ${overall}/10. ${tool.categories.join(", ")} · See features, pricing, and similar tools.`.slice(
  0,
  160,
);

const toolBreadcrumbs = [
  { name: "Home", path: "/" },
  ...(primaryCategory
    ? [{ name: primaryCategory, path: categoryHref(primaryCategory) }]
    : [{ name: "Platforms", path: "/platforms/" }]),
  { name: tool.name, path: `/tools/${tool.slug}/` },
];

const shareUrl = `${site.url}/tools/${tool.slug}/`;
const shareText = encodeURIComponent(`${tool.name} — AI agent platform on Zoetic AI`);
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={`/tools/${tool.slug}/`}
  breadcrumbs={toolBreadcrumbs}
  article={{ dateModified: tool.lastUpdated, datePublished: tool.lastUpdated }}
>
  <!-- Breadcrumb strip -->
  <div class="border-b border-border bg-surface-muted/60">
    <div class="container-site py-4">
      <Breadcrumb
        items={[
          { label: "Home", href: "/" },
          {
            label: primaryCategory ?? "Categories",
            href: primaryCategory
              ? categoryHref(primaryCategory)
              : "/categories/",
          },
          { label: tool.name },
        ]}
      />
      {
        toolHubs.length > 0 && (
          <div class="mt-4 max-w-3xl">
            <HubBacklink toolSlug={tool.slug} />
          </div>
        )
      }
    </div>
  </div>

  <!-- ═══ Section 1: Hero card ═══ -->
  <section class="bg-surface-muted/40 pb-2 pt-6 sm:pt-8">
    <div class="container-site">
      <div
        class="card-surface-lg overflow-hidden p-5 sm:p-7 lg:p-8"
      >
        <div class="grid gap-8 lg:grid-cols-12 lg:items-start lg:gap-10">
          <!-- Left: identity -->
          <div class="min-w-0 lg:col-span-6">
            <div class="flex items-start gap-4">
              <div
                class="avatar-mark h-16 w-16 text-lg sm:h-[4.5rem] sm:w-[4.5rem] sm:text-xl"
                aria-hidden="true"
              >
                {initials}
              </div>
              <div class="min-w-0">
                <h1 class="text-2xl font-bold tracking-tight text-ink sm:text-3xl">
                  {tool.name}
                </h1>
                <p class="mt-1 text-sm font-medium text-ink-muted">
                  By {company}
                </p>
                <div class="mt-2.5 flex flex-wrap items-center gap-2">
                  <div
                    class="flex items-center gap-1 text-amber-500"
                    aria-label={`Score ${starsOutOf5} out of 5`}
                  >
                    {
                      [1, 2, 3, 4, 5].map((i) => (
                        <svg
                          class="h-4 w-4"
                          viewBox="0 0 20 20"
                          fill={
                            i <= Math.round(starsOutOf5)
                              ? "currentColor"
                              : "none"
                          }
                          stroke="currentColor"
                          stroke-width="1.2"
                          aria-hidden="true"
                        >
                          <path d="M10 2.5l2.2 4.5 5 .7-3.6 3.5.9 5L10 13.9 5.5 16.2l.9-5L2.8 7.7l5-.7L10 2.5z" />
                        </svg>
                      ))
                    }
                  </div>
                  <span class="text-sm font-semibold tabular-nums text-ink"
                    >{starsOutOf5}</span
                  >
                  <span class="text-sm text-ink-soft"
                    >({overall}/10 editorial · sample reviews below)</span
                  >
                </div>
              </div>
            </div>

            <div class="mt-4 flex flex-wrap gap-2">
              {
                badges.map((b) => (
                  <span class="inline-flex items-center rounded-full bg-accent-soft px-3 py-1 text-xs font-semibold text-accent">
                    {b}
                  </span>
                ))
              }
            </div>

            <p class="mt-4 max-w-xl text-sm leading-relaxed text-ink-muted sm:text-base">
              {heroDescription}
            </p>

            <div class="mt-6 flex flex-wrap items-center gap-2.5">
              <a
                href={tool.website}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-primary px-5 py-2.5"
              >
                Visit Website
                <span aria-hidden="true">↗</span>
              </a>
              <button
                type="button"
                class="btn-secondary px-4 py-2.5"
                data-favorite
                data-tool={tool.slug}
                aria-pressed="false"
              >
                Add to Favorites
              </button>
              <button
                type="button"
                class="btn-secondary px-4 py-2.5"
                data-share
                data-url={shareUrl}
                data-title={tool.name}
              >
                Share
              </button>
            </div>
          </div>

          <!-- Right: preview frame -->
          <div class="relative lg:col-span-6">
            {
              primaryCategory && (
                <a
                  href={categoryHref(primaryCategory)}
                  class="absolute right-3 top-3 z-10 inline-flex items-center gap-1 rounded-full bg-surface/95 px-3 py-1.5 text-xs font-semibold text-accent shadow-(--shadow-sm) ring-1 ring-border backdrop-blur-sm hover:bg-accent-soft"
                >
                  #{categoryRank.rank} in {primaryCategory}
                  <span aria-hidden="true">→</span>
                </a>
              )
            }
            <div
              class="overflow-hidden rounded-[1.15rem] border border-border bg-ink shadow-(--shadow-lg)"
            >
              <!-- Browser chrome -->
              <div
                class="flex items-center gap-2 border-b border-white/10 bg-slate-900 px-3 py-2.5"
              >
                <span class="flex gap-1.5" aria-hidden="true">
                  <span class="h-2.5 w-2.5 rounded-full bg-red-400/80"></span>
                  <span class="h-2.5 w-2.5 rounded-full bg-amber-400/80"></span>
                  <span class="h-2.5 w-2.5 rounded-full bg-emerald-400/80"></span>
                </span>
                <div
                  class="ml-2 flex-1 truncate rounded-md bg-white/10 px-3 py-1 text-[11px] text-white/60"
                >
                  {websiteHost}
                </div>
              </div>
              <!-- Poster / preview (no external video) -->
              <div
                class="relative aspect-[16/10] bg-gradient-to-br from-slate-800 via-indigo-950 to-slate-900"
              >
                <div
                  class="absolute inset-0 flex flex-col items-center justify-center p-6 text-center"
                >
                  <div
                    class="flex h-16 w-16 items-center justify-center rounded-2xl bg-white/10 text-xl font-bold text-white ring-1 ring-white/20 backdrop-blur-sm sm:h-20 sm:w-20 sm:text-2xl"
                  >
                    {initials}
                  </div>
                  <p class="mt-4 text-lg font-semibold text-white sm:text-xl">
                    {tool.name}
                  </p>
                  <p class="mt-1 max-w-xs text-sm text-white/65">
                    {tool.tagline}
                  </p>
                  <div
                    class="mt-6 flex h-14 w-14 items-center justify-center rounded-full bg-white/15 text-white ring-2 ring-white/25 backdrop-blur-sm"
                    aria-hidden="true"
                    title="Preview"
                  >
                    <svg
                      class="ml-0.5 h-6 w-6"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                    >
                      <path d="M8 5.5v13l11-6.5L8 5.5z"></path>
                    </svg>
                  </div>
                  <p class="mt-3 text-[11px] font-medium uppercase tracking-wider text-white/45">
                    Product preview
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ Section 2: Sticky tabs ═══ -->
  <div
    class="sticky top-[4.25rem] z-40 border-b border-border bg-surface/95 backdrop-blur-xl"
    data-tool-tabs
  >
    <div class="container-site">
      <nav
        class="-mb-px flex gap-1 overflow-x-auto py-0 scrollbar-none"
        aria-label="On this page"
      >
        {
          tabs.map((tab) => (
            <a
              href={`#${tab.id}`}
              data-tab={tab.id}
              class="shrink-0 border-b-2 border-transparent px-3.5 py-3.5 text-sm font-medium text-ink-muted transition-colors hover:text-ink data-[active=true]:border-accent data-[active=true]:text-accent"
            >
              {tab.label}
            </a>
          ))
        }
      </nav>
    </div>
  </div>

  <!-- ═══ Main + sidebar ═══ -->
  <section class="bg-surface">
    <div class="container-site py-10 sm:py-12 lg:py-14">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-10 xl:gap-12">
        <!-- Main ~68% -->
        <div class="min-w-0 space-y-14 lg:col-span-8">
          <!-- Overview -->
          <section id="overview" class="scroll-mt-36">
            <h2 class="text-xl font-bold tracking-tight text-ink sm:text-2xl">
              Overview
            </h2>
            <div class="mt-4 space-y-4 text-base leading-relaxed text-ink-muted">
              {
                overviewParagraphs.map((p) => (
                  <p>{p}</p>
                ))
              }
              {
                tool.bestFor.length > 0 && (
                  <p>
                    <strong class="font-semibold text-ink">Best for: </strong>
                    {tool.bestFor.slice(0, 4).join(" · ")}.
                  </p>
                )
              }
            </div>

            <!-- Score breakdown (kept from prior page — high value) -->
            <div class="mt-8 rounded-[var(--radius-card)] border border-border bg-surface-muted/50 p-5 sm:p-6">
              <div class="flex flex-wrap items-end justify-between gap-3">
                <div>
                  <h3 class="text-base font-semibold text-ink">
                    Editorial score breakdown
                  </h3>
                  <p class="mt-1 text-sm text-ink-muted">
                    0–10 scale ·{" "}
                    <a
                      href="/methodology/"
                      class="font-medium text-accent hover:text-accent-hover"
                      >Methodology</a
                    >
                  </p>
                </div>
                <p class="text-2xl font-bold tabular-nums text-accent">
                  {overall}<span class="text-base font-semibold text-ink-soft"
                    >/10</span
                  >
                </p>
              </div>
              <ul class="mt-6 space-y-4">
                {
                  scoreDimensions.map(({ key, label, hint }) => {
                    const value = tool.scores[key];
                    const pct = Math.max(0, Math.min(100, (value / 10) * 100));
                    return (
                      <li>
                        <div class="flex items-end justify-between gap-3">
                          <div>
                            <p class="text-sm font-semibold text-ink">{label}</p>
                            <p class="text-xs text-ink-soft">{hint}</p>
                          </div>
                          <span class="text-sm font-bold tabular-nums text-ink">
                            {value.toFixed(1)}
                          </span>
                        </div>
                        <div
                          class="score-bar-track"
                          role="meter"
                          aria-valuenow={value}
                          aria-valuemin={0}
                          aria-valuemax={10}
                          aria-label={`${label}: ${value.toFixed(1)} of 10`}
                        >
                          <div
                            class="score-bar-fill"
                            style={`width: ${pct}%`}
                          />
                        </div>
                      </li>
                    );
                  })
                }
              </ul>
            </div>
          </section>

          <!-- Key Features -->
          <section id="features" class="scroll-mt-36">
            <h2 class="text-xl font-bold tracking-tight text-ink sm:text-2xl">
              Key Features
            </h2>
            <p class="mt-2 text-sm text-ink-muted">
              Capability flags from our directory profile. Green checks are
              currently listed as supported.
            </p>
            <ul class="mt-6 space-y-3">
              {
                featureRows.map((f) => {
                  const on = tool.features[f.key];
                  return (
                    <li
                      class:list={[
                        "flex items-start gap-4 rounded-[var(--radius-lg)] border px-4 py-4 sm:px-5",
                        on
                          ? "border-border bg-surface-muted/60"
                          : "border-border/70 bg-surface opacity-70",
                      ]}
                    >
                      <span
                        class:list={[
                          "flex h-10 w-10 shrink-0 items-center justify-center rounded-xl text-sm font-bold",
                          on
                            ? "bg-accent-soft text-accent"
                            : "bg-surface-deep text-ink-soft",
                        ]}
                        aria-hidden="true"
                      >
                        {f.icon === "users" && "◎"}
                        {f.icon === "code" && "{ }"}
                        {f.icon === "server" && "▣"}
                        {f.icon === "plug" && "⚡"}
                        {f.icon === "monitor" && "▢"}
                      </span>
                      <div class="min-w-0 flex-1">
                        <div class="flex items-start justify-between gap-3">
                          <div>
                            <p class="text-sm font-semibold text-ink">
                              {f.title}
                            </p>
                            <p class="mt-0.5 text-sm text-ink-muted">
                              {f.description}
                            </p>
                          </div>
                          <span
                            class:list={[
                              "flex h-6 w-6 shrink-0 items-center justify-center rounded-full text-xs font-bold",
                              on
                                ? "bg-emerald-100 text-emerald-700"
                                : "bg-surface-deep text-ink-soft",
                            ]}
                            aria-label={on ? "Supported" : "Not listed"}
                          >
                            {on ? "✓" : "—"}
                          </span>
                        </div>
                      </div>
                    </li>
                  );
                })
              }
            </ul>

            {
              tool.bestFor.length > 0 && (
                <div class="mt-8">
                  <h3 class="text-base font-semibold text-ink">Best for</h3>
                  <ul class="mt-3 flex flex-wrap gap-2">
                    {tool.bestFor.map((item) => (
                      <li>
                        <span class="inline-flex rounded-full border border-border bg-surface px-3.5 py-1.5 text-sm font-medium text-ink-muted">
                          {item}
                        </span>
                      </li>
                    ))}
                  </ul>
                </div>
              )
            }
          </section>

          <!-- Pricing -->
          <section id="pricing" class="scroll-mt-36">
            <h2 class="text-xl font-bold tracking-tight text-ink sm:text-2xl">
              Pricing
            </h2>
            <p class="mt-2 text-sm text-ink-muted">
              Model:{" "}
              <strong class="font-semibold text-ink"
                >{pricingLabels[tool.pricing.model]}</strong
              >
              {
                tool.pricing.notes && (
                  <>
                    {" "}
                    · {tool.pricing.notes}
                  </>
                )
              }
            </p>
            <p class="mt-1 text-xs text-ink-soft">
              Pricing is indicative and may change. Always confirm on the vendor
              site before buying.
            </p>

            <div
              class="mt-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-2"
            >
              {
                pricingPlans.map((plan) => (
                  <div
                    class:list={[
                      "relative flex flex-col rounded-[var(--radius-card)] border bg-surface p-5 sm:p-6",
                      plan.popular
                        ? "border-accent shadow-(--shadow-md) ring-1 ring-accent/15"
                        : "border-border shadow-(--shadow-xs)",
                    ]}
                  >
                    {plan.popular && (
                      <span class="absolute -top-2.5 left-1/2 -translate-x-1/2 rounded-full bg-accent px-3 py-0.5 text-[10px] font-bold uppercase tracking-wider text-accent-fg">
                        Most popular
                      </span>
                    )}
                    <p class="text-sm font-semibold text-ink">{plan.name}</p>
                    <p class="mt-3 flex items-baseline gap-1">
                      <span class="text-3xl font-bold tracking-tight text-ink">
                        {plan.price}
                      </span>
                      {plan.period && (
                        <span class="text-sm text-ink-soft">{plan.period}</span>
                      )}
                    </p>
                    {plan.description && (
                      <p class="mt-2 text-sm text-ink-muted">
                        {plan.description}
                      </p>
                    )}
                    <ul class="mt-4 flex-1 space-y-2">
                      {plan.features.map((feat) => (
                        <li class="flex items-start gap-2 text-sm text-ink-muted">
                          <span
                            class="mt-0.5 text-emerald-600"
                            aria-hidden="true"
                          >
                            ✓
                          </span>
                          <span>{feat}</span>
                        </li>
                      ))}
                    </ul>
                    <a
                      href={tool.website}
                      target="_blank"
                      rel="noopener noreferrer"
                      class:list={[
                        "mt-5 w-full justify-center",
                        plan.popular ? "btn-primary" : "btn-secondary",
                      ]}
                    >
                      {plan.cta}
                    </a>
                  </div>
                ))
              }
            </div>
          </section>

          <!-- Reviews -->
          <section id="reviews" class="scroll-mt-36">
            <h2 class="text-xl font-bold tracking-tight text-ink sm:text-2xl">
              What People Are Saying
            </h2>
            <p
              class="mt-2 rounded-lg border border-amber-200/80 bg-amber-50 px-3 py-2 text-xs font-medium text-amber-900/80"
            >
              Sample editorial reviews for layout preview — not verified user
              reviews. Real reviews will replace this section later.
            </p>
            <ul class="mt-6 grid gap-4 sm:grid-cols-3">
              {
                sampleReviews.map((r) => (
                  <li class="card-surface flex flex-col p-5">
                    <div class="flex items-center gap-3">
                      <span
