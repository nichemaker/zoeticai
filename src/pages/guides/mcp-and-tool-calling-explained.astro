    ],
  },
];

/** Practical: open protocol vs OpenAI Assistants managed runtime */
const mcpVsAssistantsRows = [
  {
    label: "What it is",
    cells: [
      "Open protocol / standard for connecting AI to tools & data",
      "Proprietary product + API for building assistants",
    ],
  },
  {
    label: "Vendor lock-in",
    cells: [
      "Low (model-agnostic)",
      "High (tied to OpenAI)",
