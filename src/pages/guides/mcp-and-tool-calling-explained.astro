      "Tool calling core; MCP bridges vary by version",
      "Product agents and custom orchestration",
    ],
  },
  {
    label: "Workflow / no-code",
    cells: [
      "n8n (+ community MCP tooling)",
      "Agent nodes + connectors; protocol support growing",
      "Ops automation with AI steps",
    ],
  },
  {
    label: "Enterprise suites",
    cells: [
      "Copilot Studio, Agentforce, Bedrock, ServiceNow…",
      "Native connectors dominate; MCP often secondary",
      "Process agents on systems of record",
    ],
  },
];

const platformSupport: {
  group: string;
  items: { name: string; note: string; href: string }[];
}[] = [
  {
    group: "Strong MCP / client momentum",
    items: [
      {
        name: "Anthropic ecosystem (Claude, Claude Code, Agent SDK)",
        note: "MCP originated in this ecosystem; deep client and docs investment.",
        href: "/tools/anthropic-claude-agent-sdk/",
      },
      {
        name: "Cursor",
        note: "Coding agent / IDE with MCP tool integration for extended capabilities.",
        href: "/tools/cursor/",
      },
      {
        name: "Cline",
        note: "Open-source IDE agent with MCP as a first-class extension path.",
        href: "/tools/cline/",
      },
      {
        name: "Claude Code",
        note: "Terminal-native agent with MCP tool extension as a core workflow pattern.",
