---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { latestGuides } from "../../data/guides";
---

<BaseLayout
  title="AI Agent Platform Guides"
  description="Practical guides on evaluating, comparing, and shipping AI agent platforms — frameworks, enterprise suites, MCP, and buyer checklists."
  canonical="/guides/"
  breadcrumbs={[
    { name: "Home", path: "/" },
    { name: "Guides", path: "/guides/" },
  ]}
>
  <section class="page-hero">
    <div class="page-hero-glow" aria-hidden="true"></div>
    <div class="container-site relative py-11 sm:py-14">
      <Breadcrumb
        items={[
          { label: "Home", href: "/" },
          { label: "Guides" },
        ]}
      />
      <h1 class="text-page-title mt-8">Guides</h1>
      <p class="text-body-lg mt-3.5 max-w-2xl">
        Practical writing for teams buying and shipping AI agents — evaluation,
        architecture choices, and operating discipline.
      </p>
    </div>
  </section>

  <section class="bg-surface">
    <div class="container-site section-y">
      <div class="grid auto-rows-fr gap-4 md:grid-cols-2 md:gap-5 lg:grid-cols-3 lg:gap-6">
        {
          latestGuides.map((guide) => (
            <article class="card-interactive group relative flex h-full min-h-[13.5rem] flex-col p-6 sm:p-7">
              <div class="flex flex-wrap items-center gap-2 text-[11px] font-medium text-ink-soft">
                <span class="pill-accent normal-case tracking-normal">
                  {guide.category}
                </span>
                <span aria-hidden="true" class="text-border-strong">
                  ·
                </span>
                <time datetime={guide.date}>{guide.readTime} read</time>
              </div>
              <h2 class="mt-4 text-lg font-semibold leading-snug tracking-tight text-ink transition-colors group-hover:text-accent">
                <a
                  href={`/guides/${guide.slug}/`}
                  class="after:absolute after:inset-0 focus-visible:outline-none"
                >
                  {guide.title}
                </a>
              </h2>
              <p class="mt-2.5 flex-1 text-sm leading-relaxed text-ink-muted">
                {guide.excerpt}
              </p>
              <span class="mt-5 text-sm font-semibold text-accent">
                Read guide
                <span
                  class="inline-block transition-transform duration-200 ease-[var(--ease-out-soft)] group-hover:translate-x-0.5"
                  aria-hidden="true"
                >
                  {" "}
                  →
                </span>
              </span>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
