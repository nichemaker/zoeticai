---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import {
  latestGuides,
  guideHref,
  getGuideBySlug,
  getTopicHub,
  isHubPage,
  guideLinkLabel,
} from "../../data/guides";

const platformsHub = getTopicHub("agent-platforms");
const codingHub = getTopicHub("coding-agents");
const platformsPreview = getGuideBySlug(platformsHub.slug);
const codingPreview = getGuideBySlug(codingHub.slug);

const secondaryHub = codingPreview
  ? {
      hub: codingHub,
      preview: codingPreview,
      spokeCount:
        codingHub.spokeGuides.length + (codingHub.spokeTools?.length ?? 0),
    }
  : null;

const otherGuides = latestGuides.filter((g) => !isHubPage(g.slug));
---

<BaseLayout
  title="AI Agent Platform Guides"
  description="Start with the AI Agent Platforms Guide 2026 pillar, then open comparisons, TCO, frameworks, and coding-agent deep-dives."
  canonical="/guides/"
  breadcrumbs={[
    { name: "Home", path: "/" },
    { name: "Guides", path: "/guides/" },
  ]}
>
  <section class="page-hero">
    <div class="page-hero-glow" aria-hidden="true"></div>
    <div class="container-site relative py-11 sm:py-14">
      <Breadcrumb
        items={[
          { label: "Home", href: "/" },
          { label: "Guides" },
        ]}
      />
      <h1 class="text-page-title mt-8">Guides</h1>
      <p class="text-body-lg mt-3.5 max-w-2xl">
        Start with the{" "}
        <a
          href={guideHref(platformsHub.slug)}
          class="font-semibold text-accent hover:text-accent-hover"
          >AI Agent Platforms Guide</a
        >{" "}
        — the central hub for choosing, comparing, and evaluating platforms —
        then open the spoke articles that match your decision.
      </p>
    </div>
  </section>

  <!-- Start here: primary pillar -->
  {
    platformsPreview && (
      <section class="border-b border-border bg-surface-muted">
        <div class="container-site section-y">
          <p class="eyebrow">Start here</p>
          <h2 class="text-section-title mt-2">Pillar guide</h2>
          <p class="mt-2 max-w-2xl text-base text-ink-muted">
            The main entry point for AI agent platforms research on this site.
          </p>

          <article class="mt-8 rounded-2xl border border-accent/25 bg-surface p-6 shadow-(--shadow-sm) sm:p-8 lg:p-10">
            <div class="flex flex-col gap-6 lg:flex-row lg:items-start lg:justify-between">
              <div class="max-w-2xl">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="pill-accent">Primary hub</span>
                  <span class="text-[11px] font-medium text-ink-soft">
                    {platformsPreview.readTime} read ·{" "}
                    {platformsHub.spokeGuides.length} linked guides
                  </span>
                </div>
                <h3 class="mt-4 text-2xl font-bold tracking-tight text-ink sm:text-3xl">
                  <a
                    href={guideHref(platformsHub.slug)}
                    class="hover:text-accent"
                  >
                    {platformsPreview.title}
                  </a>
                </h3>
                <p class="mt-3 text-base leading-relaxed text-ink-muted">
                  {platformsHub.description}
                </p>
                <ul class="mt-6 grid gap-2 sm:grid-cols-2">
                  {platformsHub.spokeGuides.slice(0, 6).map((s) => (
                    <li>
                      <a
                        href={guideHref(s.slug)}
                        class="text-sm font-medium text-accent hover:text-accent-hover"
                      >
                        {guideLinkLabel(s.slug)} →
                      </a>
                    </li>
                  ))}
                </ul>
                {platformsHub.spokeGuides.length > 6 && (
                  <p class="mt-3 text-xs font-medium text-ink-soft">
                    +{platformsHub.spokeGuides.length - 6} more comparisons and
                    guides inside the pillar
                  </p>
                )}
              </div>
              <a
                href={guideHref(platformsHub.slug)}
                class="btn-primary shrink-0 self-start px-6 py-3"
              >
                Open pillar guide →
              </a>
            </div>
          </article>

          {
            secondaryHub && (
              <div class="mt-6">
                <p class="text-sm font-semibold text-ink">Also start here</p>
                <a
                  href={guideHref(secondaryHub.hub.slug)}
                  class="card-interactive mt-3 flex flex-col p-5 sm:flex-row sm:items-center sm:justify-between sm:gap-6 sm:p-6"
                >
                  <span>
                    <span class="pill-accent">Coding hub</span>
                    <span class="mt-2 block text-lg font-semibold text-ink">
                      {secondaryHub.preview.title}
                    </span>
                    <span class="mt-1 block text-sm text-ink-muted">
                      {secondaryHub.hub.description}
                    </span>
                  </span>
                  <span class="mt-3 shrink-0 text-sm font-semibold text-accent sm:mt-0">
                    Open hub →
                  </span>
                </a>
              </div>
            )
          }
        </div>
      </section>
    )
  }

  <!-- All other guides -->
  <section class="bg-surface">
    <div class="container-site section-y">
      <div class="mb-8">
        <p class="eyebrow">All guides</p>
        <h2 class="text-section-title mt-2">Comparisons, roundups & deep-dives</h2>
        <p class="mt-2 max-w-2xl text-sm text-ink-muted">
          Spoke articles that hang off the platforms pillar (and the coding hub).
          Prefer the{" "}
          <a
            href={guideHref(platformsHub.slug)}
            class="font-semibold text-accent hover:text-accent-hover"
            >AI Agent Platforms Guide</a
          >{" "}
          first if you are new to the topic.
        </p>
      </div>
      <div class="grid auto-rows-fr gap-4 md:grid-cols-2 md:gap-5 lg:grid-cols-3 lg:gap-6">
        {
          otherGuides.map((guide) => (
            <article class="card-interactive group relative flex h-full min-h-[13.5rem] flex-col p-6 sm:p-7">
              <div class="flex flex-wrap items-center gap-2 text-[11px] font-medium text-ink-soft">
                <span class="pill-accent normal-case tracking-normal">
                  {guide.category}
                </span>
                <span aria-hidden="true" class="text-border-strong">
                  ·
                </span>
                <time datetime={guide.date}>{guide.readTime} read</time>
              </div>
              <h2 class="mt-4 text-lg font-semibold leading-snug tracking-tight text-ink transition-colors group-hover:text-accent">
                <a
                  href={guideHref(guide.slug)}
                  class="after:absolute after:inset-0 focus-visible:outline-none"
                >
                  {guide.title}
                </a>
              </h2>
              <p class="mt-2.5 flex-1 text-sm leading-relaxed text-ink-muted">
                {guide.excerpt}
              </p>
              <span class="mt-5 text-sm font-semibold text-accent">
                Read guide
                <span
                  class="inline-block transition-transform duration-200 ease-[var(--ease-out-soft)] group-hover:translate-x-0.5"
                  aria-hidden="true"
                >
                  {" "}
                  →
                </span>
              </span>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
