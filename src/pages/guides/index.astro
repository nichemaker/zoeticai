---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { latestGuides } from "../../data/guides";
---

<BaseLayout
  title="Guides"
  description="Practical guides on evaluating, comparing, and shipping AI agent platforms."
>
  <section
    class="relative overflow-hidden border-b border-border bg-surface-muted"
  >
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_70%_50%_at_0%_0%,_var(--color-accent-soft)_0%,_transparent_55%)]"
      aria-hidden="true"
    >
    </div>
    <div class="container-site relative py-10 sm:py-12">
      <Breadcrumb
        items={[
          { label: "Home", href: "/" },
          { label: "Guides" },
        ]}
      />
      <h1
        class="mt-7 text-3xl font-bold tracking-tight text-ink sm:mt-8 sm:text-4xl"
      >
        Guides
      </h1>
      <p class="mt-3 max-w-2xl text-base leading-relaxed text-ink-muted sm:text-lg">
        Practical writing for teams buying and shipping AI agents — evaluation,
        architecture choices, and operating discipline.
      </p>
    </div>
  </section>

  <section class="bg-surface">
    <div class="container-site section-y">
      <div class="grid auto-rows-fr gap-4 md:grid-cols-3 md:gap-5">
        {
          latestGuides.map((guide) => (
            <article class="card-interactive group relative flex h-full min-h-[14rem] flex-col p-6 sm:p-7">
              <div class="flex items-center gap-2 text-[11px] font-semibold uppercase tracking-wider text-ink-soft">
                <span class="rounded-md bg-accent-soft px-2 py-0.5 text-accent normal-case tracking-normal">
                  {guide.category}
                </span>
                <span aria-hidden="true">·</span>
                <time datetime={guide.date}>{guide.readTime} read</time>
              </div>
              <h2 class="mt-4 text-lg font-semibold leading-snug tracking-tight text-ink transition-colors group-hover:text-accent">
                <a
                  href={`/guides/${guide.slug}/`}
                  class="after:absolute after:inset-0 focus-visible:outline-none"
                >
                  {guide.title}
                </a>
              </h2>
              <p class="mt-2.5 flex-1 text-sm leading-relaxed text-ink-muted">
                {guide.excerpt}
              </p>
              <span class="mt-5 text-sm font-semibold text-accent">
                Read guide →
              </span>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
