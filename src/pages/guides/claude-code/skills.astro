const starterSkills = [
  "Bundled /code-review and /doctor — zero install, immediate payoff",
  "One project skill: “how we open a PR in this repo”",
  "One personal skill: your preferred debugging or commit message style",
  "Only then: a marketplace pack if a real gap remains",
];

const powerUserSkills = [
  "Domain packs for your stack (migrations, frontend design, security review)",
  "Release and incident runbooks as project skills",
  "Skills that call into MCP tools with clear guardrails",
  "Subagent + skill combos for review-while-implement workflows",
  "A small internal marketplace or monorepo of company skills",
];

const toc = [
  { id: "introduction", label: "Why skills matter" },
  { id: "quick-verdict", label: "Quick verdict" },
  { id: "what-are-skills", label: "What are Claude Code Skills?" },
  { id: "how-to-use", label: "How to add and use skills" },
  { id: "best-skills", label: "Best skills (2026)" },
  { id: "vs-plugins-agents", label: "Skills vs plugins vs agents" },
  { id: "marketplace", label: "Marketplace & discovery" },
  { id: "recommendations", label: "Practical recommendations" },
  { id: "related", label: "Related guides" },
