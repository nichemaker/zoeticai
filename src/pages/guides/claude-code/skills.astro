const published = "2026-08-12";
const readTime = "12 min";
const slug = "claude-code/skills";

const extensionCompare = [
  {
    label: "What it is",
    cells: [
      "On-demand procedure / domain playbook (SKILL.md + optional files)",
      "Installable package that can ship skills, hooks, and config",
      "Separate Claude instance with its own context for a subtask",
      "Slash entry point; now largely unified with skills",
    ],
  },
  {
    label: "When it loads",
    cells: [
      "When relevant or when you invoke /name",
      "When installed/enabled for the session or project",
      "When the main agent (or you) spins it up for a job",
      "On explicit /command (or auto via skill rules)",
    ],
  },
  {
    label: "Best for",
    cells: [
      "Repeatable workflows you do not want in every session’s context",
      "Sharing and updating a set of capabilities across machines/teams",
      "Isolated research, review, or long side work without polluting main chat",
      "Quick manual triggers for known procedures",
