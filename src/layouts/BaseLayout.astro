---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Seo from "../components/Seo.astro";
import { site } from "../data/site";
import {
  getSiteOrigin,
  buildCanonical,
  buildDocumentTitle,
  buildImageUrl,
  type JsonLd,
  type SeoInput,
  type SeoOgType,
} from "../lib/seo";
import {
  buildArticleGraph,
  buildHomeGraph,
  buildWebPageGraph,
  type BreadcrumbItem,
} from "../lib/jsonld";

interface Props {
  /** Page title (site name appended unless titleAbsolute) */
  title: string;
  description?: string;
  /** Canonical path or absolute URL (query strings stripped) */
  canonical?: string;
  /** OG/Twitter image — site-relative or absolute */
  image?: string;
  /** @deprecated Use `image` */
  ogImage?: string;
  type?: SeoOgType;
  robots?: SeoInput["robots"];
  /**
   * Optional extra JSON-LD nodes (merged into @graph).
   * Prefer breadcrumbs/article props for standard patterns.
   */
  jsonLd?: JsonLd | JsonLd[];
  titleAbsolute?: boolean;
  /** Homepage: WebSite + Organization + Project graph */
  isHome?: boolean;
  /** Article-style pages (guides) — emits Article + WebPage + BreadcrumbList */
  isArticle?: boolean;
  /** Breadcrumb trail for JSON-LD (and optional UI elsewhere) */
  breadcrumbs?: BreadcrumbItem[];
  /** Article metadata for guide/comparison pages */
  article?: {
    headline?: string;
    description?: string;
    datePublished: string;
    dateModified?: string;
  };
  /**
   * When true (default for non-home pages with breadcrumbs), emit WebPage graph.
   * Set false to pass fully custom jsonLd only.
   */
  includeWebPageSchema?: boolean;
}

const {
  title,
  description = site.description,
  canonical: canonicalProp,
  image,
  ogImage,
  type,
  robots,
  jsonLd,
  titleAbsolute = false,
  isHome = false,
  isArticle = false,
  breadcrumbs,
  article,
  includeWebPageSchema = true,
} = Astro.props;

const origin = getSiteOrigin(Astro.site);
const resolvedImage = image ?? ogImage ?? site.defaultOgImage;
const resolvedType: SeoOgType = type ?? (isArticle ? "article" : "website");
const documentTitle = buildDocumentTitle(title, titleAbsolute);
const pageUrl = buildCanonical(Astro.url.pathname, {
  override: canonicalProp,
  origin,
});
const imageUrl = buildImageUrl(resolvedImage, origin);

/** Build the page @graph */
function buildPageJsonLd(): JsonLd | undefined {
  if (isHome) {
    return buildHomeGraph(origin);
  }

  const crumbs: BreadcrumbItem[] =
    breadcrumbs ??
    [
      { name: "Home", path: "/" },
      { name: title, path: Astro.url.pathname },
    ];

  if (isArticle && article) {
    return buildArticleGraph({
      origin,
      pageUrl,
      headline: article.headline ?? title,
      description: article.description ?? description,
      datePublished: article.datePublished,
      dateModified: article.dateModified,
      imageUrl,
      breadcrumbs: crumbs,
    });
  }

  if (includeWebPageSchema && breadcrumbs) {
    return buildWebPageGraph({
      origin,
      pageUrl,
      name: documentTitle,
      description,
      breadcrumbs: crumbs,
      imageUrl,
      dateModified: article?.dateModified,
    });
  }

  // Custom-only payload
  if (jsonLd) {
    return Array.isArray(jsonLd) || jsonLd["@graph"]
      ? (jsonLd as JsonLd)
      : jsonLd;
  }

  return undefined;
}

const schema = buildPageJsonLd();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content={site.themeColor} />

    <Seo
      title={title}
      description={description}
      canonical={canonicalProp}
      image={resolvedImage}
      type={resolvedType}
      robots={robots}
      jsonLd={schema}
      titleAbsolute={titleAbsolute}
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="flex min-h-screen flex-col bg-surface text-ink">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:min-h-11 focus:rounded-[var(--radius-pill)] focus:bg-accent focus:px-5 focus:py-2.5 focus:text-sm focus:font-semibold focus:text-accent-fg focus:shadow-(--shadow-md)"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
