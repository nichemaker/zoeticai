---
/**
 * Shared long-form guide layout — premium article + sidebar.
 * No author box. Reuses BaseLayout, design system, header/footer.
 */
import BaseLayout from "./BaseLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import HubBacklink from "../components/HubBacklink.astro";
import TableOfContents from "../components/guide/TableOfContents.astro";
import GuideSidebar from "../components/guide/GuideSidebar.astro";
import GuideExplore from "../components/GuideExplore.astro";
import type { TocItem } from "../components/guide/TableOfContents.astro";
import type { ToolCategory } from "../types/tool";
import { site } from "../data/site";

interface Props {
  title: string;
  description: string;
  /** Category pill label */
  category: string;
  /** ISO date YYYY-MM-DD */
  published: string;
  readTime: string;
  /** Guide slug for hubs / related */
  slug: string;
  /** Optional hero image */
  heroImage?: string;
  heroImageAlt?: string;
  /** Short label for breadcrumb trail */
  breadcrumbLabel?: string;
  /** Canonical path override (default /guides/{slug}/) */
  canonical?: string;
  /** Explicit TOC; if omitted, TOC is built client-side from H2s */
  toc?: TocItem[];
  /** Show hub backlink when guide is a spoke */
  showHubBacklink?: boolean;
  /** Categories for GuideExplore */
  exploreCategories?: ToolCategory[];
  /** Show GuideExplore footer block */
  showExplore?: boolean;
  /** Show soft implementation CTA */
  showCta?: boolean;
  dateModified?: string;
}

const {
  title,
  description,
  category,
  published,
  readTime,
  slug,
  heroImage,
  heroImageAlt = "",
  breadcrumbLabel,
  canonical,
  toc,
  showHubBacklink = true,
  exploreCategories = ["Frameworks", "Enterprise", "No-Code"],
  showExplore = true,
  showCta = true,
  dateModified,
} = Astro.props;

const crumbLabel = breadcrumbLabel ?? title.slice(0, 48);
const path = canonical ?? `/guides/${slug}/`;
const publishedLabel = new Date(published + "T00:00:00").toLocaleDateString(
  "en-US",
  { year: "numeric", month: "long", day: "numeric" },
);
---

<BaseLayout
  title={title}
  description={description}
  image={heroImage}
  canonical={path}
  isArticle
  breadcrumbs={[
    { name: "Home", path: "/" },
    { name: "Guides", path: "/guides/" },
    { name: crumbLabel, path },
  ]}
  article={{
    headline: title,
    description,
    datePublished: published,
    dateModified: dateModified ?? published,
  }}
>
  <!-- Article header -->
  <header class="border-b border-border bg-surface-muted/50">
    <div class="container-site py-8 sm:py-10 lg:py-12">
      <Breadcrumb
        items={[
          { label: "Home", href: "/" },
          { label: "Guides", href: "/guides/" },
          { label: crumbLabel },
        ]}
      />

      {
        showHubBacklink && (
          <div class="mt-5 max-w-3xl">
            <HubBacklink guideSlug={slug} />
          </div>
        )
      }

      <div class="mt-6 max-w-3xl">
        <span class="pill-accent">{category}</span>
        <h1
          class="mt-4 text-[1.85rem] font-bold leading-[1.15] tracking-tight text-ink sm:text-4xl sm:leading-tight lg:text-[2.5rem]"
        >
          {title}
        </h1>
        <p class="mt-4 text-base leading-relaxed text-ink-muted sm:text-lg">
          {description}
        </p>

        <!-- Meta row — date + read time only (no author) -->
        <div
          class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 border-t border-border/80 pt-5 text-sm text-ink-soft"
        >
          <span class="inline-flex items-center gap-1.5">
            <svg
              class="h-4 w-4 opacity-70"
              viewBox="0 0 20 20"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
            >
              <rect x="3" y="4" width="14" height="13" rx="2"></rect>
              <path d="M3 8h14M7 2.5v3M13 2.5v3" stroke-linecap="round"
              ></path>
            </svg>
            <time datetime={published}>{publishedLabel}</time>
          </span>
          <span class="inline-flex items-center gap-1.5">
            <svg
              class="h-4 w-4 opacity-70"
              viewBox="0 0 20 20"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
            >
              <circle cx="10" cy="10" r="7"></circle>
              <path d="M10 6v4.5l2.5 1.5" stroke-linecap="round"></path>
            </svg>
            {readTime} read
          </span>
        </div>
      </div>

      {
        heroImage && (
          <figure class="mt-8 overflow-hidden rounded-[var(--radius-xl)] border border-border bg-surface shadow-(--shadow-md)">
            <img
              src={heroImage}
              alt={heroImageAlt || title}
              width="1600"
              height="900"
              class="h-auto w-full object-cover"
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
          </figure>
        )
      }
    </div>
  </header>

  <!-- Body: main + sidebar -->
  <div class="bg-surface">
    <div class="container-site py-10 sm:py-12 lg:py-14">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-10 xl:gap-12">
        <article class="min-w-0 lg:col-span-8">
          <TableOfContents items={toc} />

          <div class="guide-prose mt-10" data-guide-body>
            <slot />
          </div>
        </article>

        <div class="lg:col-span-4">
          <GuideSidebar slug={slug} />
        </div>
      </div>
    </div>
  </div>

  {
    showExplore && (
      <GuideExplore slug={slug} categories={exploreCategories} />
    )
  }

  {
    showCta && (
      <section class="section-cta">
        <div class="section-cta-glow" aria-hidden="true"></div>
        <div class="container-site relative section-y-tight">
          <div class="mx-auto flex max-w-2xl flex-col items-center text-center">
            <p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-white/80">
              Next step
            </p>
            <h2 class="mt-3 text-2xl font-bold tracking-tight sm:text-3xl">
              Put this guide to work
            </h2>
            <p class="mt-4 text-base leading-relaxed text-white/85">
              Browse scored agent platforms or talk through architecture for a
              production shortlist.
            </p>
            <div class="mt-8 flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
              <a
                href="/platforms/"
                class="inline-flex items-center justify-center rounded-[var(--radius-pill)] bg-white px-7 py-3.5 text-sm font-semibold text-accent shadow-(--shadow-md)"
              >
                Browse platforms
              </a>
              <a
                href={site.cta.href}
                class="inline-flex items-center justify-center rounded-[var(--radius-pill)] border border-white/35 bg-white/10 px-7 py-3.5 text-sm font-semibold text-white"
              >
                Talk about implementation
              </a>
            </div>
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>

<style is:global>
  /* Long-form guide typography */
  .guide-prose {
    color: var(--color-ink-muted);
    font-size: 1.0625rem;
    line-height: 1.75;
  }

  .guide-prose > * + * {
    margin-top: 1.15rem;
  }

  .guide-prose .guide-h2,
  .guide-prose h2 {
    margin-top: 2.75rem;
    margin-bottom: 0.85rem;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.25;
    color: var(--color-ink);
    scroll-margin-top: 7rem;
  }

  @media (min-width: 640px) {
    .guide-prose .guide-h2,
    .guide-prose h2 {
      font-size: 1.75rem;
      margin-top: 3.25rem;
    }
  }

  .guide-prose h3,
  .guide-prose .guide-h3 {
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
    font-size: 1.125rem;
    font-weight: 650;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    scroll-margin-top: 7rem;
  }

  .guide-prose p {
    margin-top: 0.9rem;
    color: var(--color-ink-muted);
  }

  .guide-prose a {
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-accent) 30%, transparent);
    text-underline-offset: 3px;
  }

  .guide-prose a:hover {
    color: var(--color-accent-hover);
    text-decoration-color: var(--color-accent);
  }

  .guide-prose strong {
    font-weight: 650;
    color: var(--color-ink);
  }

  .guide-prose ul:not([class]),
  .guide-prose ol:not([class]) {
    margin-top: 1rem;
    padding-left: 1.25rem;
  }

  .guide-prose ul:not([class]) {
    list-style: disc;
  }

  .guide-prose ol:not([class]) {
    list-style: decimal;
  }

  .guide-prose li:not([class]) {
    margin-top: 0.4rem;
    padding-left: 0.25rem;
  }

  .guide-prose section + section {
    margin-top: 0;
  }

  /* First H2 after TOC shouldn't double-space awkwardly */
  .guide-prose > section:first-child .guide-h2,
  .guide-prose > h2:first-child,
  .guide-prose > section:first-child h2:first-child {
    margin-top: 0.5rem;
  }
</style>
