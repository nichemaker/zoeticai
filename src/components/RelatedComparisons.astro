---
/**
 * End-of-comparison block: platform profiles + other head-to-head guides
 * + related (non-comparison) guides. Supports 2- or 3-tool comparison guides.
 */
import { getToolBySlug } from "../data/tools";
import {
  comparisonToolProfiles,
  getRelatedComparisons,
  getRelatedGuidesForArticle,
  guideHref,
  comparisonLinkLabel,
  guideLinkLabel,
  isComparisonGuide,
  methodologyLink,
} from "../data/guides";
import { categoryHref } from "../data/categories";
import type { ToolCategory } from "../types/tool";

interface Props {
  slug: string;
  /** Category hubs to surface */
  categories?: ToolCategory[];
}

const { slug, categories = [] } = Astro.props;

const profiles = isComparisonGuide(slug)
  ? comparisonToolProfiles[slug]
  : undefined;

const profileTools =
  profiles?.map((p) => ({
    ...p,
    tool: getToolBySlug(p.slug),
  })) ?? [];

const visibleProfiles = profileTools.filter((p) => p.tool);
const relatedComparisons = getRelatedComparisons(slug);
const relatedGuides = getRelatedGuidesForArticle(slug, {
  excludeComparisons: true,
  limit: 5,
});

const profileGridClass =
  visibleProfiles.length >= 3
    ? "mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3"
    : "mt-6 grid gap-4 sm:grid-cols-2";
---

{
  (visibleProfiles.length > 0 ||
    relatedComparisons.length > 0 ||
    relatedGuides.length > 0) && (
    <section
      class="mt-14 sm:mt-16 border-t border-border pt-12"
      id="related-comparisons"
    >
      {
        visibleProfiles.length > 0 && (
          <div class="mb-10">
            <h2 class="guide-h2">Platform profiles</h2>
            <p class="mt-2 text-base leading-relaxed text-ink-muted">
              Open the full directory listings for scores, features, pricing
              notes, and similar tools.
            </p>
            <div class={profileGridClass}>
              {visibleProfiles.map(({ label, tool }) =>
                tool ? (
                  <a
                    href={`/tools/${tool.slug}/`}
                    class="card-interactive group flex flex-col p-5 sm:p-6"
                  >
                    <span class="text-xs font-semibold uppercase tracking-wider text-ink-soft">
                      Platform profile
                    </span>
                    <span class="mt-2 text-lg font-semibold text-ink group-hover:text-accent">
                      {label}
                    </span>
                    <span class="mt-2 text-sm leading-relaxed text-ink-muted line-clamp-2">
                      {tool.tagline}
                    </span>
                    <span class="mt-4 text-sm font-semibold text-accent">
                      View {tool.name} →
                    </span>
                  </a>
                ) : null,
              )}
            </div>
          </div>
        )
      }

      {
        relatedComparisons.length > 0 && (
          <div class="mb-10">
            <h2 class="guide-h2">Related comparisons</h2>
            <p class="mt-2 text-base leading-relaxed text-ink-muted">
              More head-to-head guides for frameworks, coding agents, workflow
              platforms, and enterprise suites.
            </p>
            <ul class="mt-6 space-y-3">
              {relatedComparisons.map((g) => (
                <li>
                  <a
                    href={guideHref(g.slug)}
                    class="card-interactive group flex flex-col p-5 sm:flex-row sm:items-center sm:justify-between sm:gap-4"
                  >
                    <span>
                      <span class="text-base font-semibold text-ink group-hover:text-accent">
                        {comparisonLinkLabel(g.slug)}
                      </span>
                      <span class="mt-1 block text-sm text-ink-muted">
                        {g.excerpt}
                      </span>
                    </span>
                    <span class="mt-3 shrink-0 text-sm font-semibold text-accent sm:mt-0">
                      Read →
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      {
        relatedGuides.length > 0 && (
          <div>
            <h2 class="guide-h2">Related guides</h2>
            <p class="mt-2 text-base leading-relaxed text-ink-muted">
              Roundups, cost models, and evaluation playbooks that pair with
              this comparison.
            </p>
            <ul class="mt-6 space-y-3">
              {relatedGuides.map((g) => (
                <li>
                  <a
                    href={guideHref(g.slug)}
                    class="card-interactive group flex flex-col p-5 sm:flex-row sm:items-center sm:justify-between sm:gap-4"
                  >
                    <span>
                      <span class="text-base font-semibold text-ink group-hover:text-accent">
                        {guideLinkLabel(g.slug)}
                      </span>
                      <span class="mt-1 block text-sm text-ink-muted">
                        {g.excerpt}
                      </span>
                    </span>
                    <span class="mt-3 shrink-0 text-sm font-semibold text-accent sm:mt-0">
                      Read →
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      <p class="mt-8 text-sm text-ink-muted">
        Also see{" "}
        <a
          href={methodologyLink.href}
          class="font-semibold text-accent hover:text-accent-hover"
        >
          how we evaluate AI agent platforms
        </a>
        {
          categories.length > 0 && (
            <>
              {" "}
              and browse{" "}
              {categories.map((c, i) => (
                <>
                  {i > 0 && (i === categories.length - 1 ? " and " : ", ")}
                  <a
                    href={categoryHref(c)}
                    class="font-semibold text-accent hover:text-accent-hover"
                  >
                    {c}
                  </a>
                </>
              ))}
              .
            </>
          )
        }
      </p>
    </section>
  )
}

<style>
  .guide-h2 {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--color-ink);
    line-height: 1.25;
  }
  @media (min-width: 640px) {
    .guide-h2 {
      font-size: 1.75rem;
    }
  }
</style>
