---
import type { Tool } from "../types/tool";
import { categoryHref } from "../data/categories";

interface Props {
  tool: Tool;
  /** Wider min-width for horizontal scroll strips */
  scrollItem?: boolean;
  /** Max feature/category tags on the card (default 4). */
  maxTags?: number;
}

const { tool, scrollItem = false, maxTags = 4 } = Astro.props;

const score = tool.scores.overall.toFixed(1);

const featureTags: string[] = [
  ...(tool.features.multiAgent ? ["multi-agent"] : []),
  ...(tool.features.openSource ? ["open source"] : []),
  ...(tool.features.selfHost ? ["self-host"] : []),
  ...(tool.features.mcpSupport ? ["MCP"] : []),
  ...(tool.features.computerUse ? ["computer use"] : []),
];

const tags: string[] = [
  tool.pricing.model.replace(/-/g, " "),
  ...featureTags,
  ...tool.categories,
].filter((tag, i, arr) => arr.indexOf(tag) === i).slice(0, maxTags);

const initials = tool.name
  .split(/\s+/)
  .slice(0, 2)
  .map((w) => w[0])
  .join("")
  .toUpperCase();

const secondaryCategory = tool.categories.find(
  (c) => c !== tool.categories[0],
);
---

<article
  class:list={[
    "card-surface group relative flex h-full flex-col p-5 transition-shadow duration-150 hover:shadow-(--shadow-md)",
    scrollItem && "w-[min(100%,18.5rem)] shrink-0 sm:w-72",
  ]}
  data-tool-card
  data-name={tool.name.toLowerCase()}
  data-score={tool.scores.overall}
>
  <div class="flex items-start gap-3">
    <div
      class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-border bg-surface-muted text-xs font-bold tracking-tight text-ink-muted"
      aria-hidden="true"
    >
      {initials}
    </div>
    <div class="min-w-0 flex-1">
      <div class="flex items-start justify-between gap-2">
        <h3 class="text-base font-semibold leading-snug text-ink">
          <a
            href={`/tools/${tool.slug}/`}
            class="after:absolute after:inset-0 focus-visible:outline-none group-hover:text-accent"
          >
            {tool.name}
          </a>
        </h3>
        <span
          class="inline-flex shrink-0 items-center rounded-md bg-accent-soft px-2 py-0.5 text-xs font-semibold tabular-nums text-accent"
          title="Overall score out of 10"
        >
          {score}
        </span>
      </div>
      <p class="mt-1.5 line-clamp-2 text-sm leading-relaxed text-ink-muted">
        {tool.tagline}
      </p>
    </div>
  </div>

  <ul class="mt-4 flex flex-wrap gap-1.5">
    {
      tags.map((tag) => (
        <li>
          <span class="inline-flex rounded-md border border-border bg-surface-muted px-2 py-0.5 text-[11px] font-medium capitalize text-ink-muted">
            {tag}
          </span>
        </li>
      ))
    }
  </ul>

  {
    secondaryCategory && (
      <p class="relative z-10 mt-auto pt-4 text-xs text-ink-soft">
        Also in{" "}
        <a
          href={categoryHref(secondaryCategory)}
          class="font-medium text-ink-muted hover:text-accent"
        >
          {secondaryCategory}
        </a>
      </p>
    )
  }
</article>
