---
/**
 * Hub page block: lists all spoke guides (and optional tool profiles).
 * Also emits ItemList JSON-LD for the cluster (search engines).
 */
import { getToolBySlug } from "../data/tools";
import {
  guideHref,
  guideLinkLabel,
  getGuideBySlug,
  getTopicHub,
  type TopicHub,
  type TopicHubId,
} from "../data/guides";
import { site } from "../data/site";

interface Props {
  hubId: TopicHubId;
  /** Section heading */
  title?: string;
  description?: string;
  /** Show tool profile spokes */
  showTools?: boolean;
  /** Anchor id for in-page nav */
  id?: string;
}

const {
  hubId,
  title = "In this topic cluster",
  description,
  showTools = true,
  id = "cluster",
} = Astro.props;

const hub: TopicHub = getTopicHub(hubId);
const origin = site.url.replace(/\/$/, "");

const guideItems = hub.spokeGuides
  .map((s) => {
    const guide = getGuideBySlug(s.slug);
    if (!guide) return null;
    return { ...s, guide };
  })
  .filter((x): x is NonNullable<typeof x> => Boolean(x));

const toolItems =
  showTools && hub.spokeTools
    ? hub.spokeTools
        .map((s) => {
          const tool = getToolBySlug(s.slug);
          if (!tool) return null;
          return { ...s, tool };
        })
        .filter((x): x is NonNullable<typeof x> => Boolean(x))
    : [];

const listName = `${hub.name} guides and resources`;
const itemListElements: object[] = [];
let pos = 1;
for (const item of guideItems) {
  itemListElements.push({
    "@type": "ListItem",
    position: pos++,
    name: item.guide.title,
    url: `${origin}${guideHref(item.guide.slug)}`,
  });
}
for (const item of toolItems) {
  itemListElements.push({
    "@type": "ListItem",
    position: pos++,
    name: item.tool.name,
    url: `${origin}/tools/${item.tool.slug}/`,
  });
}

const itemListJson = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: listName,
  description: hub.description,
  numberOfItems: itemListElements.length,
  itemListElement: itemListElements,
};
---

<section class="mt-14 sm:mt-16" id={id}>
  <h2 class="guide-h2">{title}</h2>
  <p class="mt-3 text-base leading-relaxed text-ink-muted">
    {
      description ??
        "Start with the overview above, then open the deep-dives that match your decision. Every spoke links back here."
    }
  </p>

  {
    guideItems.length > 0 && (
      <div class="mt-8">
        <h3 class="text-sm font-semibold uppercase tracking-wider text-ink-soft">
          Guides & comparisons
        </h3>
        <ul class="mt-4 space-y-3">
          {guideItems.map(({ guide, blurb }) => (
            <li>
              <a
                href={guideHref(guide.slug)}
                class="card-interactive group flex flex-col p-5 sm:flex-row sm:items-start sm:justify-between sm:gap-6"
              >
                <span class="min-w-0">
                  <span class="text-base font-semibold text-ink transition-colors group-hover:text-accent">
                    {guideLinkLabel(guide.slug)}
                  </span>
                  <span class="mt-1 block text-sm leading-relaxed text-ink-muted">
                    {blurb}
                  </span>
                  <span class="mt-2 inline-flex items-center gap-1.5 text-[11px] font-medium text-ink-soft">
                    <span class="rounded-full bg-surface-muted px-2 py-0.5 ring-1 ring-border">
                      {guide.category}
                    </span>
                    <span>{guide.readTime} read</span>
                  </span>
                </span>
                <span class="mt-3 shrink-0 text-sm font-semibold text-accent sm:mt-1">
                  Open →
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )
  }

  {
    toolItems.length > 0 && (
      <div class="mt-10">
        <h3 class="text-sm font-semibold uppercase tracking-wider text-ink-soft">
          Platform profiles
        </h3>
        <p class="mt-2 text-sm text-ink-muted">
          Scored directory listings for tools in this cluster.
        </p>
        <ul class="mt-4 grid gap-3 sm:grid-cols-2">
          {toolItems.map(({ tool, blurb }) => (
            <li>
              <a
                href={`/tools/${tool.slug}/`}
                class="card-interactive group flex h-full flex-col p-5"
              >
                <span class="flex items-center justify-between gap-2">
                  <span class="text-base font-semibold text-ink group-hover:text-accent">
                    {tool.name}
                  </span>
                  <span class="tabular-nums text-xs font-semibold text-ink-soft">
                    {tool.scores.overall.toFixed(1)}
                  </span>
                </span>
                <span class="mt-1.5 text-sm leading-relaxed text-ink-muted">
                  {blurb}
                </span>
                <span class="mt-3 text-sm font-semibold text-accent">
                  View profile →
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )
  }
</section>

<script type="application/ld+json" set:html={JSON.stringify(itemListJson)} />

<style>
  .guide-h2 {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--color-ink);
    line-height: 1.25;
  }
  @media (min-width: 640px) {
    .guide-h2 {
      font-size: 1.75rem;
    }
  }
</style>
