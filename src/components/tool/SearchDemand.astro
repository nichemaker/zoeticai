---
/**
 * Compact search-interest signal for tool detail pages.
 * Hidden when no demand data is present.
 */
import type { SearchTrend, Tool, ToolSearchDemand } from "../../types/tool";

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;

function resolveDemand(t: Tool): ToolSearchDemand | null {
  const volume = t.searchDemand?.searchVolume ?? t.searchVolume;
  const trend = t.searchDemand?.searchTrend ?? t.searchTrend;
  const label = t.searchDemand?.searchLabel ?? t.searchLabel;
  if (volume == null && !trend && !label) return null;
  return { searchVolume: volume, searchTrend: trend, searchLabel: label };
}

const demand = resolveDemand(tool);

const trendMeta: Record<
  SearchTrend,
  { label: string; className: string; icon: string }
> = {
  rising: {
    label: "Rising",
    className: "bg-emerald-50 text-emerald-800 ring-emerald-200/80",
    icon: "↑",
  },
  stable: {
    label: "Stable",
    className: "bg-slate-100 text-slate-700 ring-slate-200/80",
    icon: "→",
  },
  cooling: {
    label: "Cooling",
    className: "bg-amber-50 text-amber-900 ring-amber-200/80",
    icon: "↓",
  },
};

function formatVolume(n: number): string {
  if (n >= 1_000_000) return `${(n / 1_000_000).toFixed(1).replace(/\.0$/, "")}M`;
  if (n >= 10_000) return `${Math.round(n / 1000)}K`;
  if (n >= 1000) return `${(n / 1000).toFixed(1).replace(/\.0$/, "")}K`;
  return n.toLocaleString("en-US");
}

const trend = demand?.searchTrend ? trendMeta[demand.searchTrend] : null;
---

{
  demand && (
    <div class="card-surface p-5 sm:p-6">
      <div class="flex items-start justify-between gap-3">
        <div>
          <p class="text-xs font-bold uppercase tracking-wider text-accent">
            Search demand
          </p>
          <p class="mt-1 text-[11px] text-ink-soft">Brand interest signal</p>
        </div>
        {trend && (
          <span
            class:list={[
              "inline-flex items-center gap-1 rounded-full px-2.5 py-1 text-[11px] font-semibold ring-1",
              trend.className,
            ]}
          >
            <span aria-hidden="true">{trend.icon}</span>
            {trend.label}
          </span>
        )}
      </div>

      {demand.searchVolume != null && (
        <p class="mt-4">
          <span class="text-2xl font-bold tabular-nums tracking-tight text-ink">
            {formatVolume(demand.searchVolume)}
          </span>
          <span class="ml-1.5 text-xs font-medium text-ink-soft">
            searches / mo
          </span>
        </p>
      )}

      {demand.searchLabel && (
        <p class="mt-2 text-sm font-medium leading-snug text-ink-muted">
          {demand.searchLabel}
        </p>
      )}

      <p class="mt-3 text-[11px] leading-relaxed text-ink-soft">
        Editorial estimate for planning — not live SEO API data.
      </p>
    </div>
  )
}
