---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  href?: string;
  linkLabel?: string;
}

const {
  eyebrow,
  title,
  description,
  href,
  linkLabel = "View all",
} = Astro.props;
---

<div
  class="mb-8 flex flex-col gap-5 sm:mb-11 sm:flex-row sm:items-end sm:justify-between sm:gap-8"
>
  <div class="max-w-2xl">
    {
      eyebrow && (
        <p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-accent">
          {eyebrow}
        </p>
      )
    }
    <h2
      class:list={[
        "text-2xl font-bold tracking-tight text-ink sm:text-[1.75rem] sm:leading-tight",
        eyebrow ? "mt-2.5" : "",
      ]}
    >
      {title}
    </h2>
    {
      description && (
        <p class="mt-2.5 max-w-xl text-[0.95rem] leading-relaxed text-ink-muted sm:text-base">
          {description}
        </p>
      )
    }
  </div>
  {
    href && (
      <a
        href={href}
        class="inline-flex shrink-0 items-center gap-1 self-start rounded-lg text-sm font-semibold text-accent transition-colors hover:text-accent-hover sm:self-auto"
      >
        {linkLabel}
        <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">
          →
        </span>
      </a>
    )
  }
</div>
