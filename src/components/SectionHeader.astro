---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  href?: string;
  linkLabel?: string;
}

const {
  eyebrow,
  title,
  description,
  href,
  linkLabel = "View all",
} = Astro.props;
---

<div
  class="mb-10 flex flex-col gap-5 sm:mb-12 sm:flex-row sm:items-end sm:justify-between sm:gap-10"
>
  <div class="max-w-2xl">
    {
      eyebrow && (
        <p class="eyebrow">{eyebrow}</p>
      )
    }
    <h2
      class:list={[
        "text-section-title",
        eyebrow ? "mt-2.5" : "",
      ]}
    >
      {title}
    </h2>
    {
      description && (
        <p class="mt-3 max-w-xl text-[0.9375rem] leading-relaxed text-ink-muted sm:text-base">
          {description}
        </p>
      )
    }
  </div>
  {
    href && (
      <a
        href={href}
        class="group inline-flex shrink-0 items-center gap-1.5 self-start rounded-[var(--radius-pill)] border border-border bg-surface px-4 py-2 text-sm font-semibold text-accent shadow-(--shadow-xs) transition-[border-color,box-shadow,colors] duration-200 hover:border-accent/25 hover:bg-accent-soft hover:shadow-(--shadow-sm) sm:self-auto"
      >
        {linkLabel}
        <span
          aria-hidden="true"
          class="transition-transform duration-200 ease-[var(--ease-out-soft)] group-hover:translate-x-0.5"
        >
          →
        </span>
      </a>
    )
  }
</div>
