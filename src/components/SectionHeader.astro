---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  href?: string;
  linkLabel?: string;
}

const {
  eyebrow,
  title,
  description,
  href,
  linkLabel = "View all",
} = Astro.props;
---

<div
  class="mb-8 flex flex-col gap-4 sm:mb-10 sm:flex-row sm:items-end sm:justify-between"
>
  <div class="max-w-2xl">
    {
      eyebrow && (
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-accent">
          {eyebrow}
        </p>
      )
    }
    <h2
      class:list={[
        "text-2xl font-bold tracking-tight text-ink sm:text-3xl",
        eyebrow && "mt-2",
      ]}
    >
      {title}
    </h2>
    {
      description && (
        <p class="mt-2 text-base leading-relaxed text-ink-muted">
          {description}
        </p>
      )
    }
  </div>
  {
    href && (
      <a
        href={href}
        class="shrink-0 text-sm font-semibold text-accent hover:text-accent-hover"
      >
        {linkLabel}
        <span aria-hidden="true"> →</span>
      </a>
    )
  }
</div>
