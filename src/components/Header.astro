---
/**
 * Site header — logo left, primary nav, newsletter CTA right.
 */
import { primaryNav, site } from "../data/site";

const newsletterHref = "https://zoeticai.substack.com";

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";

function isCurrent(href: string) {
  const normalized = href.replace(/\/$/, "") || "/";
  if (normalized === "/") return pathname === "/";
  return pathname === normalized || pathname.startsWith(`${normalized}/`);
}
---

<header
  class="sticky top-0 z-50 border-b border-border/70 bg-surface/95 backdrop-blur-xl backdrop-saturate-150"
>
  <div class="container-site">
    <div class="flex h-[4.25rem] items-center gap-6 lg:gap-10">
      <!-- Logo -->
      <a
        href="/"
        class="group flex min-h-11 shrink-0 items-center gap-2.5 rounded-[var(--radius-md)]"
        aria-label={`${site.brand} home`}
      >
        <span class="brand-mark" aria-hidden="true">
          <svg
            class="h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M12 3l1.8 5.4L19 10.2l-5.2 1.8L12 17.4l-1.8-5.4L5 10.2l5.2-1.8L12 3z"
              fill="currentColor"
              opacity="0.95"></path>
            <circle cx="18.5" cy="6" r="1.4" fill="currentColor" opacity="0.7"
            ></circle>
          </svg>
        </span>
        <span class="text-base font-bold tracking-tight text-ink">
          Zoetic<span class="text-accent">AI</span>
        </span>
      </a>

      <!-- Desktop nav — horizontal, minimal -->
      <nav
        class="hidden flex-1 items-center justify-center gap-1 md:flex"
        aria-label="Primary"
      >
        {
          primaryNav.map((link) => (
            <a
              href={link.href}
              class="link-nav"
              aria-current={isCurrent(link.href) ? "page" : undefined}
            >
              {link.label}
            </a>
          ))
        }
      </nav>

      <!-- Right action: newsletter -->
      <div class="ml-auto flex items-center gap-1.5 sm:gap-2 md:ml-0">
        <a
          href={newsletterHref}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary hidden px-5 py-2 sm:inline-flex"
        >
          Join Newsletter
        </a>

        <!-- Mobile search shortcut -->
        <a
          href="/platforms/"
          class="inline-flex h-11 w-11 items-center justify-center rounded-full text-ink-muted transition-colors hover:bg-surface-deep hover:text-ink md:hidden"
          aria-label="Browse platforms"
        >
          <svg
            class="h-5 w-5"
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            aria-hidden="true"
          >
            <circle cx="8.5" cy="8.5" r="5.5"></circle>
            <path d="M13 13l3.5 3.5" stroke-linecap="round"></path>
          </svg>
        </a>

        <button
          type="button"
          class="inline-flex h-11 w-11 items-center justify-center rounded-full text-ink transition-colors hover:bg-surface-deep md:hidden"
          aria-expanded="false"
          aria-controls="mobile-nav"
          data-menu-toggle
        >
          <span class="sr-only">Open menu</span>
          <svg
            class="h-5 w-5"
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"
            data-icon-menu
          >
            <path d="M3 5h14M3 10h14M3 15h14" stroke-linecap="round"></path>
          </svg>
          <svg
            class="hidden h-5 w-5"
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"
            data-icon-close
          >
            <path d="M5 5l10 10M15 5L5 15" stroke-linecap="round"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile nav -->
  <nav
    id="mobile-nav"
    class="hidden border-t border-border/80 bg-surface md:hidden"
    aria-label="Mobile"
    data-mobile-nav
  >
    <div class="container-site py-4">
      <ul class="flex flex-col gap-0.5">
        {
          primaryNav.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={[
                  "block rounded-[var(--radius-md)] px-3 py-2.5 text-sm font-medium transition-colors",
                  isCurrent(link.href)
                    ? "bg-accent-soft text-accent"
                    : "text-ink-muted hover:bg-surface-muted hover:text-ink",
                ]}
                aria-current={isCurrent(link.href) ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mt-4 border-t border-border pt-4">
        <a
          href={newsletterHref}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary w-full"
        >
          Join Newsletter
        </a>
      </div>
    </div>
  </nav>
</header>

<script>
  const toggle = document.querySelector("[data-menu-toggle]");
  const nav = document.querySelector("[data-mobile-nav]");
  const iconMenu = document.querySelector("[data-icon-menu]");
  const iconClose = document.querySelector("[data-icon-close]");

  if (toggle && nav) {
    toggle.addEventListener("click", () => {
      const open = nav.classList.toggle("hidden") === false;
      toggle.setAttribute("aria-expanded", String(open));
      toggle.querySelector(".sr-only")!.textContent = open
        ? "Close menu"
        : "Open menu";
      iconMenu?.classList.toggle("hidden", open);
      iconClose?.classList.toggle("hidden", !open);
    });
  }
</script>
