---
import { primaryNav, site } from "../data/site";

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";

function isCurrent(href: string) {
  const normalized = href.replace(/\/$/, "") || "/";
  if (normalized === "/") return pathname === "/";
  return pathname === normalized || pathname.startsWith(`${normalized}/`);
}
---

<header
  class="sticky top-0 z-50 border-b border-border/70 bg-surface/90 backdrop-blur-xl backdrop-saturate-150"
>
  <div class="container-site">
    <div class="flex h-16 items-center gap-4 sm:h-[4.25rem] sm:gap-6">
      <!-- Logo -->
      <a
        href="/"
        class="group flex shrink-0 items-center gap-2.5"
        aria-label={`${site.brand} home`}
      >
        <span class="brand-mark" aria-hidden="true">Z</span>
        <span
          class="text-[0.95rem] font-bold tracking-tight text-ink sm:text-base"
        >
          {site.brand}
        </span>
      </a>

      <!-- Desktop nav (centered cluster after logo) -->
      <nav
        class="hidden flex-1 items-center justify-center gap-0.5 md:flex"
        aria-label="Primary"
      >
        {
          primaryNav.map((link) => (
            <a
              href={link.href}
              class="link-nav"
              aria-current={isCurrent(link.href) ? "page" : undefined}
            >
              {link.label}
            </a>
          ))
        }
      </nav>

      <!-- Search + CTAs -->
      <div class="ml-auto flex items-center gap-2 sm:gap-2.5 md:ml-0">
        <form
          action="/platforms/"
          method="get"
          role="search"
          class="hidden min-w-0 max-w-[11rem] lg:block lg:max-w-[13.5rem]"
        >
          <label for="header-search" class="sr-only">Search directory</label>
          <div class="relative">
            <svg
              class="pointer-events-none absolute left-3 top-1/2 h-3.5 w-3.5 -translate-y-1/2 text-ink-soft"
              viewBox="0 0 20 20"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              aria-hidden="true"
            >
              <circle cx="8.5" cy="8.5" r="5.5"></circle>
              <path d="M13 13l3.5 3.5" stroke-linecap="round"></path>
            </svg>
            <input
              id="header-search"
              type="search"
              name="q"
              placeholder="Search…"
              class="input-search py-2 text-[0.8125rem]"
              autocomplete="off"
            />
          </div>
        </form>

        <a
          href="/methodology/"
          class="btn-header-ghost hidden sm:inline-flex"
        >
          Methodology
        </a>
        <a href="/contact/" class="btn-primary hidden px-4 py-2 sm:inline-flex">
          Contact
        </a>

        <!-- Mobile: search + menu -->
        <a
          href="/platforms/"
          class="inline-flex h-9 w-9 items-center justify-center rounded-[var(--radius-pill)] text-ink-muted transition-colors hover:bg-surface-muted hover:text-ink lg:hidden"
          aria-label="Search platforms"
        >
          <svg
            class="h-5 w-5"
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            aria-hidden="true"
          >
            <circle cx="8.5" cy="8.5" r="5.5"></circle>
            <path d="M13 13l3.5 3.5" stroke-linecap="round"></path>
          </svg>
        </a>

        <button
          type="button"
          class="inline-flex h-9 w-9 items-center justify-center rounded-[var(--radius-pill)] text-ink transition-colors hover:bg-surface-muted md:hidden"
          aria-expanded="false"
          aria-controls="mobile-nav"
          data-menu-toggle
        >
          <span class="sr-only">Open menu</span>
          <svg
            class="h-5 w-5"
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"
            data-icon-menu
          >
            <path d="M3 5h14M3 10h14M3 15h14" stroke-linecap="round"></path>
          </svg>
          <svg
            class="hidden h-5 w-5"
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"
            data-icon-close
          >
            <path d="M5 5l10 10M15 5L5 15" stroke-linecap="round"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile nav panel -->
  <nav
    id="mobile-nav"
    class="hidden border-t border-border/80 bg-surface/98 backdrop-blur-xl md:hidden"
    aria-label="Mobile"
    data-mobile-nav
  >
    <div class="container-site py-4">
      <form
        action="/platforms/"
        method="get"
        role="search"
        class="mb-3"
      >
        <label for="mobile-search" class="sr-only">Search directory</label>
        <div class="relative">
          <svg
            class="pointer-events-none absolute left-3 top-1/2 h-3.5 w-3.5 -translate-y-1/2 text-ink-soft"
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            aria-hidden="true"
          >
            <circle cx="8.5" cy="8.5" r="5.5"></circle>
            <path d="M13 13l3.5 3.5" stroke-linecap="round"></path>
          </svg>
          <input
            id="mobile-search"
            type="search"
            name="q"
            placeholder="Search platforms…"
            class="input-search py-2.5"
            autocomplete="off"
          />
        </div>
      </form>

      <ul class="flex flex-col gap-0.5 pb-2">
        {
          primaryNav.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={[
                  "block rounded-[var(--radius-md)] px-3 py-2.5 text-sm font-medium transition-colors",
                  isCurrent(link.href)
                    ? "bg-accent-soft text-accent"
                    : "text-ink-muted hover:bg-surface-muted hover:text-ink",
                ]}
                aria-current={isCurrent(link.href) ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
        <li class="mt-2 border-t border-border pt-3">
          <a
            href="/methodology/"
            class="block rounded-[var(--radius-md)] px-3 py-2.5 text-sm font-medium text-ink-muted hover:bg-surface-muted hover:text-ink"
          >
            Methodology
          </a>
        </li>
        <li class="px-1 pt-1">
          <a href="/contact/" class="btn-primary w-full">Contact</a>
        </li>
      </ul>
    </div>
  </nav>
</header>

<script>
  const toggle = document.querySelector("[data-menu-toggle]");
  const nav = document.querySelector("[data-mobile-nav]");
  const iconMenu = document.querySelector("[data-icon-menu]");
  const iconClose = document.querySelector("[data-icon-close]");

  if (toggle && nav) {
    toggle.addEventListener("click", () => {
      const open = nav.classList.toggle("hidden") === false;
      toggle.setAttribute("aria-expanded", String(open));
      toggle.querySelector(".sr-only")!.textContent = open
        ? "Close menu"
        : "Open menu";
      iconMenu?.classList.toggle("hidden", open);
      iconClose?.classList.toggle("hidden", !open);
    });
  }
</script>
