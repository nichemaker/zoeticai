---
import { primaryNav, site } from "../data/site";

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";

function isCurrent(href: string) {
  const normalized = href.replace(/\/$/, "") || "/";
  if (normalized === "/") return pathname === "/";
  return pathname === normalized || pathname.startsWith(`${normalized}/`);
}
---

<header class="sticky top-0 z-50 border-b border-border bg-surface/95">
  <div class="container-site">
    <div class="flex h-16 items-center gap-3 sm:h-[4.25rem] sm:gap-6">
      <!-- Logo placeholder -->
      <a
        href="/"
        class="flex shrink-0 items-center gap-2.5"
        aria-label={`${site.name} home`}
      >
        <span
          class="flex h-8 w-8 items-center justify-center rounded-lg bg-accent text-sm font-bold text-accent-fg"
          aria-hidden="true"
        >
          AI
        </span>
        <span class="hidden text-base font-semibold tracking-tight text-ink sm:inline">
          {site.name}
        </span>
      </a>

      <!-- Desktop nav -->
      <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
        {
          primaryNav.map((link) => (
            <a
              href={link.href}
              class="link-nav rounded-md px-3 py-2"
              aria-current={isCurrent(link.href) ? "page" : undefined}
            >
              {link.label}
            </a>
          ))
        }
      </nav>

      <!-- Search (desktop / tablet) -->
      <form
        action="/search/"
        method="get"
        role="search"
        class="ml-auto hidden min-w-0 flex-1 max-w-xs sm:block lg:max-w-sm"
      >
        <label for="header-search" class="sr-only">Search directory</label>
        <div class="relative">
          <svg
            class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-ink-soft"
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            aria-hidden="true"
          >
            <circle cx="8.5" cy="8.5" r="5.5" />
            <path d="M13 13l3.5 3.5" stroke-linecap="round" />
          </svg>
          <input
            id="header-search"
            type="search"
            name="q"
            placeholder="Search agents & tools…"
            class="input-search"
            autocomplete="off"
          />
        </div>
      </form>

      <!-- Mobile: search icon + menu toggle -->
      <div class="ml-auto flex items-center gap-1 sm:ml-0">
        <a
          href="/search/"
          class="inline-flex h-10 w-10 items-center justify-center rounded-lg text-ink-muted hover:bg-surface-muted hover:text-ink sm:hidden"
          aria-label="Search"
        >
          <svg
            class="h-5 w-5"
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            aria-hidden="true"
          >
            <circle cx="8.5" cy="8.5" r="5.5" />
            <path d="M13 13l3.5 3.5" stroke-linecap="round" />
          </svg>
        </a>

        <button
          type="button"
          class="inline-flex h-10 w-10 items-center justify-center rounded-lg text-ink md:hidden"
          aria-expanded="false"
          aria-controls="mobile-nav"
          data-menu-toggle
        >
          <span class="sr-only">Open menu</span>
          <svg
            class="h-5 w-5"
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"
            data-icon-menu
          >
            <path d="M3 5h14M3 10h14M3 15h14" stroke-linecap="round" />
          </svg>
          <svg
            class="hidden h-5 w-5"
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"
            data-icon-close
          >
            <path d="M5 5l10 10M15 5L5 15" stroke-linecap="round" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile nav panel -->
  <nav
    id="mobile-nav"
    class="hidden border-t border-border bg-surface md:hidden"
    aria-label="Mobile"
    data-mobile-nav
  >
    <div class="container-site py-3">
      <form action="/search/" method="get" role="search" class="mb-3 sm:hidden">
        <label for="mobile-search" class="sr-only">Search directory</label>
        <div class="relative">
          <svg
            class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-ink-soft"
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            aria-hidden="true"
          >
            <circle cx="8.5" cy="8.5" r="5.5" />
            <path d="M13 13l3.5 3.5" stroke-linecap="round" />
          </svg>
          <input
            id="mobile-search"
            type="search"
            name="q"
            placeholder="Search agents & tools…"
            class="input-search"
            autocomplete="off"
          />
        </div>
      </form>

      <ul class="flex flex-col gap-0.5">
        {
          primaryNav.map((link) => (
            <li>
              <a
                href={link.href}
                class="block rounded-lg px-3 py-2.5 text-sm font-medium text-ink-muted hover:bg-surface-muted hover:text-ink"
                aria-current={isCurrent(link.href) ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>
</header>

<script>
  const toggle = document.querySelector("[data-menu-toggle]");
  const nav = document.querySelector("[data-mobile-nav]");
  const iconMenu = document.querySelector("[data-icon-menu]");
  const iconClose = document.querySelector("[data-icon-close]");

  if (toggle && nav) {
    toggle.addEventListener("click", () => {
      const open = nav.classList.toggle("hidden") === false;
      toggle.setAttribute("aria-expanded", String(open));
      toggle.querySelector(".sr-only")!.textContent = open
        ? "Close menu"
        : "Open menu";
      iconMenu?.classList.toggle("hidden", open);
      iconClose?.classList.toggle("hidden", !open);
    });
  }
</script>
