---
/**
 * Desktop guide sidebar — About, related guides, categories, optional CTA.
 * No author box.
 */
import {
  getRelatedReadingForArticle,
  getGuideBySlug,
  guideHref,
  guideLinkLabel,
  getTopicHub,
  latestGuides,
} from "../../data/guides";
import { getCategoryCounts, categoryHref } from "../../data/categories";
import { site } from "../../data/site";

interface Props {
  /** Current guide slug for related reading */
  slug: string;
  /** Show newsletter-style CTA */
  showNewsletter?: boolean;
}

const { slug, showNewsletter = true } = Astro.props;

const related = getRelatedReadingForArticle(slug, 6);
const pillar = getTopicHub("agent-platforms");
const pillarPreview = getGuideBySlug(pillar.slug);
const categoryCards = getCategoryCounts().slice(0, 6);

/** Fallback recent guides if related is thin */
const recent = latestGuides.filter((g) => g.slug !== slug).slice(0, 5);
const relatedList = related.length > 0 ? related : recent;
---

<aside class="space-y-5 lg:sticky lg:top-28">
  <!-- About Zoetic AI -->
  <div class="card-surface relative overflow-hidden p-5 sm:p-6">
    <div
      class="pointer-events-none absolute -right-6 -top-6 h-24 w-24 rounded-full bg-accent-soft blur-2xl"
      aria-hidden="true"
    >
    </div>
    <p class="text-sm font-semibold tracking-tight text-ink">About ZoeticAI</p>
    <p class="mt-2 text-sm leading-relaxed text-ink-muted">
      Independent directory of AI agent platforms — scored profiles, comparisons,
      and buyer frameworks so you shortlist with confidence.
    </p>
    <a href="/platforms/" class="btn-secondary mt-4 w-full text-sm">
      Explore platforms →
    </a>
    {
      pillarPreview && (
        <a
          href={guideHref(pillar.slug)}
          class="mt-2 block text-center text-sm font-semibold text-accent hover:text-accent-hover"
        >
          Platforms guide hub
        </a>
      )
    }
  </div>

  <!-- Related guides -->
  <div class="card-surface p-5 sm:p-6">
    <p class="text-sm font-semibold tracking-tight text-ink">Related Guides</p>
    <ul class="mt-4 space-y-3">
      {
        relatedList.map((g) => (
          <li>
            <a
              href={guideHref(g.slug)}
              class="group block rounded-[var(--radius-md)] -mx-1 px-1 py-0.5"
            >
              <span class="text-sm font-semibold leading-snug text-ink transition-colors group-hover:text-accent">
                {guideLinkLabel(g.slug)}
              </span>
              <span class="mt-0.5 block text-xs text-ink-soft">
                {g.category} · {g.readTime}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
    <a
      href="/guides/"
      class="mt-4 inline-flex text-sm font-semibold text-accent hover:text-accent-hover"
    >
      View all guides →
    </a>
  </div>

  <!-- Categories -->
  <div class="card-surface p-5 sm:p-6">
    <p class="text-sm font-semibold tracking-tight text-ink">Key Categories</p>
    <ul class="mt-4 space-y-2">
      {
        categoryCards.map(({ meta, count }) => (
          <li>
            <a
              href={categoryHref(meta)}
              class="flex items-center justify-between gap-2 rounded-[var(--radius-md)] px-1 py-1.5 text-sm transition-colors hover:bg-surface-muted"
            >
              <span class="font-medium text-ink-muted hover:text-ink">
                {meta.name}
              </span>
              <span class="tabular-nums text-xs font-semibold text-ink-soft">
                {count}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
    <a
      href="/categories/"
      class="mt-3 inline-flex text-sm font-semibold text-accent hover:text-accent-hover"
    >
      View all categories →
    </a>
  </div>

  <!-- Optional soft CTA -->
  {
    showNewsletter && (
      <div class="band-brand relative overflow-hidden rounded-[var(--radius-card)] p-5 text-accent-fg shadow-(--shadow-sm) sm:p-6">
        <p class="text-sm font-semibold">Stay ahead on agents</p>
        <p class="mt-1.5 text-xs leading-relaxed text-white/85">
          New comparisons, TCO notes, and evaluation playbooks for AI agent
          platforms.
        </p>
        <a
          href="/guides/"
          class="mt-4 inline-flex w-full items-center justify-center rounded-[var(--radius-pill)] bg-white px-4 py-2.5 text-sm font-semibold text-accent"
        >
          Browse guides
        </a>
      </div>
    )
  }

  <p class="px-1 text-xs text-ink-soft">
    Questions?{" "}
    <a href={site.cta.href} class="font-semibold text-accent hover:text-accent-hover"
      >Contact us</a
    >
  </p>
</aside>
