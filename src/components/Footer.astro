---
/**
 * Site footer — reference: light bg, logo + blurb + social,
 * Quick Links / Resources / Legal columns, copyright bar.
 */
import { footerGroups, footerLegal, site } from "../data/site";

const year = new Date().getFullYear();

const social = [
  {
    label: "X (Twitter)",
    href: "https://x.com",
    icon: "x",
  },
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com",
    icon: "linkedin",
  },
  {
    label: "GitHub",
    href: "https://github.com",
    icon: "github",
  },
  {
    label: "Email",
    href: `mailto:${site.email}`,
    icon: "email",
  },
] as const;
---

<footer class="mt-auto border-t border-border bg-surface">
  <div class="container-site py-14 sm:py-16">
    <div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-12 lg:gap-10">
      <!-- Brand -->
      <div class="sm:col-span-2 lg:col-span-4">
        <a href="/" class="inline-flex items-center gap-2.5">
          <span class="brand-mark" aria-hidden="true">
            <svg
              class="h-4 w-4"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M12 3l1.8 5.4L19 10.2l-5.2 1.8L12 17.4l-1.8-5.4L5 10.2l5.2-1.8L12 3z"
                fill="currentColor"
                opacity="0.95"></path>
              <circle
                cx="18.5"
                cy="6"
                r="1.4"
                fill="currentColor"
                opacity="0.7"></circle>
            </svg>
          </span>
          <span class="text-base font-bold tracking-tight text-ink">
            Zoetic<span class="text-accent">AI</span>
          </span>
        </a>
        <p class="mt-4 max-w-[17rem] text-sm leading-relaxed text-ink-muted">
          Discover the best AI agent platforms to boost productivity and ship
          with confidence.
        </p>

        <!-- Social -->
        <ul class="mt-6 flex flex-wrap items-center gap-2" aria-label="Social">
          {
            social.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="social-icon"
                  aria-label={item.label}
                  {...(item.href.startsWith("http")
                    ? { target: "_blank", rel: "noopener noreferrer" }
                    : {})}
                >
                  {item.icon === "x" && (
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.727-8.835L1.254 2.25H8.08l4.253 5.622L18.244 2.25zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77z" />
                    </svg>
                  )}
                  {item.icon === "linkedin" && (
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                    </svg>
                  )}
                  {item.icon === "github" && (
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
                    </svg>
                  )}
                  {item.icon === "email" && (
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                      <rect x="3" y="5" width="18" height="14" rx="2" />
                      <path d="M3 7l9 6 9-6" stroke-linecap="round" />
                    </svg>
                  )}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Quick Links + Resources -->
      {
        footerGroups.map((group) => (
          <div class="lg:col-span-2">
            <p class="text-sm font-semibold tracking-tight text-ink">
              {group.heading}
            </p>
            <ul class="mt-4 space-y-2.5">
              {group.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-sm text-ink-muted transition-colors hover:text-accent"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }

      <!-- Legal -->
      <div class="lg:col-span-2">
        <p class="text-sm font-semibold tracking-tight text-ink">Legal</p>
        <ul class="mt-4 space-y-2.5">
          {
            footerLegal.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-ink-muted transition-colors hover:text-accent"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div
      class="mt-12 flex flex-col gap-2 border-t border-border pt-8 sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="text-xs text-ink-soft">
        &copy; {year} {site.brand}. All rights reserved.
      </p>
      <p class="text-xs text-ink-soft">
        Independent AI agent platforms directory
      </p>
    </div>
  </div>
</footer>
