---
import { footerGroups, footerLegal, site } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-border bg-surface">
  <!-- Soft CTA band -->
  <div class="border-b border-border">
    <div class="container-site py-10 sm:py-12">
      <div
        class="band-brand relative overflow-hidden rounded-[var(--radius-xl)] px-6 py-8 text-accent-fg shadow-(--shadow-md) sm:px-10 sm:py-9"
      >
        <div
          class="pointer-events-none absolute -right-8 -top-10 h-40 w-40 rounded-full bg-white/10 blur-2xl"
          aria-hidden="true"
        >
        </div>
        <div
          class="pointer-events-none absolute -bottom-12 left-1/3 h-36 w-36 rounded-full bg-white/10 blur-2xl"
          aria-hidden="true"
        >
        </div>
        <div
          class="relative flex flex-col items-start gap-5 sm:flex-row sm:items-center sm:justify-between"
        >
          <div class="max-w-lg">
            <p class="text-lg font-bold tracking-tight sm:text-xl">
              {site.cta.label}
            </p>
            <p class="mt-1.5 text-sm leading-relaxed text-white/85">
              Talk to a team that ships production-grade AI agents and workflows.
            </p>
          </div>
          <a
            href={site.cta.href}
            class="inline-flex shrink-0 items-center justify-center rounded-[var(--radius-pill)] bg-white px-5 py-2.5 text-sm font-semibold text-accent shadow-(--shadow-sm) transition-[transform,box-shadow] duration-200 hover:shadow-(--shadow-md) active:translate-y-px"
          >
            Get in touch →
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="container-site py-12 sm:py-14">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-12 lg:gap-8">
      <!-- Brand column -->
      <div class="sm:col-span-2 lg:col-span-4">
        <a href="/" class="inline-flex items-center gap-2.5">
          <span class="brand-mark" aria-hidden="true">Z</span>
          <span class="text-[0.95rem] font-bold tracking-tight text-ink"
            >{site.brand}</span
          >
        </a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-ink-muted">
          Discover, compare, and choose AI agent platforms — scored profiles and
          practical guides for buyers and builders.
        </p>
        <p class="mt-5 text-sm">
          <a
            href="/methodology/"
            class="font-semibold text-accent transition-colors hover:text-accent-hover"
          >
            How we score platforms →
          </a>
        </p>
      </div>

      <!-- Link groups -->
      {
        footerGroups.map((group) => (
          <div class="lg:col-span-2">
            <p class="text-xs font-bold uppercase tracking-[0.12em] text-ink">
              {group.heading}
            </p>
            <ul class="mt-4 space-y-1">
              {group.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="inline-flex min-h-8 items-center text-sm text-ink-muted transition-colors hover:text-accent"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }

      <!-- Legal column -->
      <div class="lg:col-span-2">
        <p class="text-xs font-bold uppercase tracking-[0.12em] text-ink">
          Legal
        </p>
        <ul class="mt-4 space-y-1">
          {
            footerLegal.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="inline-flex min-h-8 items-center text-sm text-ink-muted transition-colors hover:text-accent"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div
      class="mt-12 flex flex-col gap-3 border-t border-border pt-7 sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="text-xs text-ink-soft">
        &copy; {year} {site.brand}. All rights reserved.
      </p>
      <p class="text-xs text-ink-soft">
        Independent AI agent platforms directory
      </p>
    </div>
  </div>
</footer>
