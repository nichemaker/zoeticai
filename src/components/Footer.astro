---
import { footerGroups, footerLegal, site } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-border bg-surface-muted">
  <!-- CTA band -->
  <div class="border-b border-border bg-surface">
    <div
      class="container-site flex flex-col items-start gap-5 py-10 sm:flex-row sm:items-center sm:justify-between sm:py-12"
    >
      <div class="max-w-md">
        <p class="text-base font-semibold tracking-tight text-ink sm:text-lg">
          {site.cta.label}
        </p>
        <p class="mt-1.5 text-sm leading-relaxed text-ink-muted">
          Talk to a team that ships production-grade AI agents and workflows.
        </p>
      </div>
      <a href={site.cta.href} class="btn-primary shrink-0"> Get in touch </a>
    </div>
  </div>

  <div class="container-site py-12 sm:py-14">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      <div class="sm:col-span-2 lg:col-span-1">
        <a href="/" class="inline-flex items-center gap-2.5">
          <span
            class="flex h-8 w-8 items-center justify-center rounded-[0.625rem] bg-accent text-[0.7rem] font-bold tracking-wide text-accent-fg"
            aria-hidden="true"
          >
            AI
          </span>
          <span class="text-[0.9375rem] font-semibold tracking-tight text-ink"
            >{site.name}</span
          >
        </a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-ink-muted">
          {site.tagline}
        </p>
        <p class="mt-5 text-sm">
          <a
            href="/methodology/"
            class="font-medium text-accent transition-colors hover:text-accent-hover"
          >
            How we score platforms →
          </a>
        </p>
      </div>

      {
        footerGroups.map((group) => (
          <div>
            <p class="eyebrow-muted">{group.heading}</p>
            <ul class="mt-4 space-y-0.5">
              {group.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="inline-flex min-h-9 items-center text-sm text-ink-muted transition-colors hover:text-ink"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div
      class="mt-12 flex flex-col gap-4 border-t border-border pt-7 sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="text-xs text-ink-soft">
        &copy; {year} {site.name}. All rights reserved.
      </p>
      <nav aria-label="Legal and company">
        <ul
          class="flex flex-wrap gap-x-5 gap-y-2 text-xs font-medium text-ink-muted"
        >
          {
            footerLegal.map((link) => (
              <li>
                <a href={link.href} class="transition-colors hover:text-ink">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
</footer>
