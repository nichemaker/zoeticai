---
/**
 * End-of-guide block: example tools + categories + related reading + methodology.
 * Related reading is contextual (newest high-signal guides first), not a dump of all articles.
 */
import { getToolBySlug } from "../data/tools";
import {
  guideExampleTools,
  guideHref,
  getRelatedReadingForArticle,
  getHubsForGuide,
  getHubBacklinkCopy,
  methodologyLink,
  guideLinkLabel,
  isHubPage,
} from "../data/guides";
import { categoryHref } from "../data/categories";
import type { ToolCategory } from "../types/tool";

interface Props {
  /** Current guide slug (to exclude from related reading) */
  slug: string;
  categories?: ToolCategory[];
}

const { slug, categories = ["Frameworks", "Enterprise"] } = Astro.props;

const examples = guideExampleTools[slug];
const tools = (examples?.slugs ?? [])
  .map((s) => getToolBySlug(s))
  .filter((t): t is NonNullable<typeof t> => Boolean(t));

const relatedReading = getRelatedReadingForArticle(slug, 7);
const parentHubs = getHubsForGuide(slug).sort((a, b) => {
  if (a.id === "agent-platforms") return -1;
  if (b.id === "agent-platforms") return 1;
  return 0;
});
const showHubReturn = !isHubPage(slug) || parentHubs.length > 0;
---

<section class="border-t border-border bg-surface-muted">
  <div class="container-site section-y">
    <div class="mx-auto max-w-3xl">
      <p class="eyebrow">Explore next</p>
      <h2 class="text-section-title mt-2.5">Put this guide to work</h2>

      {
        showHubReturn && parentHubs.length > 0 && (
          <div class="mt-8 rounded-2xl border border-accent/20 bg-surface p-5 sm:p-6">
            <p class="text-xs font-semibold uppercase tracking-wider text-accent">
              Topic hub
            </p>
            <ul class="mt-3 space-y-3">
              {parentHubs.map((hub) => {
                const copy = getHubBacklinkCopy(hub, slug);
                return (
                  <li>
                    <a
                      href={guideHref(hub.slug)}
                      class="text-base font-semibold text-ink hover:text-accent"
                    >
                      {copy.label} →
                    </a>
                    <p class="mt-1 text-sm text-ink-muted">{copy.detail}</p>
                  </li>
                );
              })}
            </ul>
          </div>
        )
      }

      {
        tools.length > 0 && (
          <div class="mt-8">
            <h3 class="text-sm font-semibold text-ink">
              {examples?.label ?? "Related platforms"}
            </h3>
            <ul class="mt-3 flex flex-wrap gap-2">
              {tools.map((t) => (
                <li>
                  <a
                    href={`/tools/${t.slug}/`}
                    class="inline-flex items-center rounded-full border border-border bg-surface px-3.5 py-1.5 text-sm font-medium text-ink-muted transition-colors hover:border-accent/30 hover:bg-accent-soft hover:text-accent"
                  >
                    {t.name}
                    <span class="ml-1.5 tabular-nums text-xs text-ink-soft">
                      {t.scores.overall.toFixed(1)}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        <div class="card-surface p-5">
          <h3 class="text-sm font-semibold text-ink">Browse by category</h3>
          <ul class="mt-3 space-y-2">
            {
              categories.map((c) => (
                <li>
                  <a
                    href={categoryHref(c)}
                    class="text-sm font-medium text-accent hover:text-accent-hover"
                  >
                    {c} platforms →
                  </a>
                </li>
              ))
            }
            <li>
              <a
                href="/platforms/"
                class="text-sm font-medium text-ink-muted hover:text-accent"
              >
                All platforms →
              </a>
            </li>
          </ul>
        </div>
        <div class="card-surface p-5">
          <h3 class="text-sm font-semibold text-ink">Trust & scoring</h3>
          <ul class="mt-3 space-y-2 text-sm">
            <li>
              <a
                href={methodologyLink.href}
                class="font-medium text-accent hover:text-accent-hover"
              >
                {methodologyLink.title} →
              </a>
            </li>
            <li>
              <a
                href="/guides/"
                class="font-medium text-ink-muted hover:text-accent"
              >
                All guides →
              </a>
            </li>
          </ul>
        </div>
      </div>

      {
        relatedReading.length > 0 && (
          <div class="mt-8" id="related-guides">
            <h3 class="text-sm font-semibold text-ink">Related guides</h3>
            <p class="mt-1 text-sm text-ink-muted">
              Newest and most relevant follow-ups for this topic.
            </p>
            <ul class="mt-4 space-y-2.5">
              {relatedReading.map((g) => (
                <li>
                  <a
                    href={guideHref(g.slug)}
                    class="group flex flex-col rounded-lg border border-border bg-surface px-4 py-3 transition-colors hover:border-accent/30 sm:flex-row sm:items-center sm:justify-between sm:gap-3"
                  >
                    <span class="text-sm font-semibold text-ink group-hover:text-accent">
                      {guideLinkLabel(g.slug)}
                    </span>
                    <span class="mt-1 shrink-0 text-xs font-medium text-ink-soft sm:mt-0">
                      {g.category} · {g.readTime}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </div>
</section>
