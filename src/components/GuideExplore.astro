---
/**
 * End-of-guide block: example tools + categories + methodology.
 */
import { getToolBySlug } from "../data/tools";
import {
  guideExampleTools,
  guideHref,
  latestGuides,
  methodologyLink,
} from "../data/guides";
import { categoryHref } from "../data/categories";
import type { ToolCategory } from "../types/tool";

interface Props {
  /** Current guide slug (to exclude from "other guides") */
  slug: string;
  categories?: ToolCategory[];
}

const { slug, categories = ["Frameworks", "Enterprise"] } = Astro.props;

const examples = guideExampleTools[slug];
const tools = (examples?.slugs ?? [])
  .map((s) => getToolBySlug(s))
  .filter((t): t is NonNullable<typeof t> => Boolean(t));

const otherGuides = latestGuides.filter((g) => g.slug !== slug);
---

<section class="border-t border-border bg-surface-muted">
  <div class="container-site section-y">
    <div class="mx-auto max-w-3xl">
      <p
        class="text-[11px] font-semibold uppercase tracking-[0.16em] text-accent"
      >
        Explore next
      </p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-ink sm:text-[1.75rem]">
        Put this guide to work
      </h2>

      {
        tools.length > 0 && (
          <div class="mt-8">
            <h3 class="text-sm font-semibold text-ink">
              {examples?.label ?? "Related platforms"}
            </h3>
            <ul class="mt-3 flex flex-wrap gap-2">
              {tools.map((t) => (
                <li>
                  <a
                    href={`/tools/${t.slug}/`}
                    class="inline-flex items-center rounded-full border border-border bg-surface px-3.5 py-1.5 text-sm font-medium text-ink-muted transition-colors hover:border-accent/30 hover:bg-accent-soft hover:text-accent"
                  >
                    {t.name}
                    <span class="ml-1.5 tabular-nums text-xs text-ink-soft">
                      {t.scores.overall.toFixed(1)}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        <div class="card-surface p-5">
          <h3 class="text-sm font-semibold text-ink">Browse by category</h3>
          <ul class="mt-3 space-y-2">
            {
              categories.map((c) => (
                <li>
                  <a
                    href={categoryHref(c)}
                    class="text-sm font-medium text-accent hover:text-accent-hover"
                  >
                    {c} platforms →
                  </a>
                </li>
              ))
            }
            <li>
              <a
                href="/platforms/"
                class="text-sm font-medium text-ink-muted hover:text-accent"
              >
                All platforms →
              </a>
            </li>
          </ul>
        </div>
        <div class="card-surface p-5">
          <h3 class="text-sm font-semibold text-ink">Trust & scoring</h3>
          <ul class="mt-3 space-y-2 text-sm">
            <li>
              <a
                href={methodologyLink.href}
                class="font-medium text-accent hover:text-accent-hover"
              >
                {methodologyLink.title} →
              </a>
            </li>
            {
              otherGuides.map((g) => (
                <li>
                  <a
                    href={guideHref(g.slug)}
                    class="font-medium text-ink-muted hover:text-accent"
                  >
                    {g.title} →
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
