{
  "name": "ai-directory",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/seo-postbuild.mjs && node scripts/verify-tool-pages.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "verify:tools": "node scripts/verify-tool-pages.mjs",
    "verify:seo": "node scripts/seo-postbuild.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "indexnow:guides": "node scripts/indexnow.mjs --preset guides",
    "indexnow:tools": "node scripts/indexnow.mjs --preset tools",
    "indexnow:recent": "node scripts/indexnow.mjs --preset recent",
    "indexnow:sitemap": "node scripts/indexnow.mjs --sitemap",
    "deploy": "npm run build && wrangler deploy",
    "deploy:notify": "npm run deploy && npm run indexnow:sitemap"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.6",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "wrangler": "^4.119.0"
  }
}
